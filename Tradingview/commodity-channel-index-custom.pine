// © goodgains
//@version=5
indicator(title="Commodity Channel Index Custom", shorttitle="CCI", format=format.price, precision=2)

// @keywords: cci, commodity-channel-index, smoothing-line, cci-smoothing, sma, ema, rma, wma, vwma, overbought-level, oversold-level, zero-line, band-fill, deviation-bands, hlc3-source, ma-offset, configurable-length, smoothing-method, oscillator, overbought-oversold

length = input.int(14, minval=1)
src = input(hlc3, title="Source")
ma = ta.sma(src, length)
cci = (src - ma) / (0.015 * ta.dev(src, length))
cci_plot = plot(cci, "CCI", color=#2962FF)
band1 = hline(100, "Upper Band", color=#787B86, linestyle=hline.style_dashed)
hline(0, "Middle Band", color=color.new(#787B86, 50))
band0 = hline(-100, "Lower Band", color=#787B86, linestyle=hline.style_dashed)
fill(band1, band0, color=color.rgb(33, 150, 243, 90), title="Background")

ma(source, length, type) =>
    switch type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

typeMA = input.string(title = "Method", defval = "SMA", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Smoothing")
smoothingLength = input.int(title = "Length", defval = 1, minval = 1, maxval = 100, group="Smoothing")
cci_offset = input.int(title = "CCI MA Offset", defval = 9, minval = 1, maxval = 100, group="Smoothing")

smoothingLine = ma(cci, smoothingLength, typeMA)
smoothed_plot = plot(smoothingLine, title="Smoothing Line", color=#f37f20, display=display.all, offset = cci_offset)

fill(cci_plot, smoothed_plot, color = cci > smoothingLine[cci_offset] ? color.new(color.teal, 70) : color.new(color.red, 70))

