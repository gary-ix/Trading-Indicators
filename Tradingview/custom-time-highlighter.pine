//@version=5
indicator(title="Custom Time Highlighter", shorttitle="CTH", overlay=true)

// @keywords: custom-time-highlighter, session-highlight, hour-range, background-highlight, start-hour, end-hour, after-market-hours, time-window, intraday-zones, overlay-highlight, hour-filter, trading-hours, session-background, time-of-day, periodic-highlight, clock-hours, daily-schedule, session-shading, time-based-bg, market-hours

// Input: Specify the hour and minute for highlighting
start_hour = input(12, title="Start Hour")
end_hour = input(19, title="End Hour")

// Function to check if the current candle matches the specified time on Sundays
is_highlight_time() => hour >= start_hour and hour < end_hour


const int afterMarketStart = 18
const int afterMarketEnd = 8

is_after_market() => hour >= afterMarketStart and hour < afterMarketEnd

// Plot a background color for the specified time
bgcolor(is_highlight_time() ? color.new(color.orange, 50)
 : is_after_market() ? color.new(color.blue, 50) 
 : na)


