////BASELINE / SSL1 / SSL2 / EXIT MOVING AVERAGE VALUES
fury_maType = input.string(title='SSL1 / Baseline Type', defval='HMA', options=['SMA', 'EMA', 'DEMA', 'TEMA', 'LSMA', 'WMA', 'MF', 'VAMA', 'TMA', 'HMA', 'JMA', 'Kijun v2', 'EDSMA', 'McGinley'], group="Strategy 7: Fury")
