alarm_label_TP_short = input.string('TP short', 'Label Take Profit short', group='Basic alarm system')
alarm_label_SL = input.string('SL', 'Label Stop-Loss', group='Basic alarm system')

isrealPrice=input(false,"Enable Real Price Filter", group='Real Price')
so = input(true, 'Show Open Price', group='Real Price')
// sh = input(false, 'Show High Price', group='Real Price')
// sl = input(false, 'Show Low Price', group='Real Price')
// sc = input(false, 'Show Close Price', group='Real Price')
max_dis_pct=input(0.5,"Max Distance %", group='Real Price')

//Real Price{=============================================================================================================

security_1 = request.security(ticker.new(syminfo.prefix, syminfo.ticker), timeframe.period, open)
op = so ? security_1 : na
// security_2 = request.security(ticker.new(syminfo.prefix, syminfo.ticker), timeframe.period, high)
// hi = sh ? security_2 : na
// security_3 = request.security(ticker.new(syminfo.prefix, syminfo.ticker), timeframe.period, low)
