// © goodgains
//@version=5
indicator(title="On Balance Volume", shorttitle="OBV", format=format.volume)

// @keywords: cumulative-obv, volume-sign-accumulation, obv-smoothing-ma, optional-ma-offset, obv-ma-fill, no-volume-error-check, sma-ema-rma-wma-vwma, volume-momentum-line, obv-trend-compare, smoothed-obv-plot, format-volume-pane, price-volume-flow, ma-method-select, smoothing-length-input, fill-between-obv-ma, teal-red-fill-zone, offset-smoothed-line, standard-obv-indicator, volume-cumulative-trend, obv-plot-line


var cumVol = 0.
cumVol += nz(volume)
if barstate.islast and cumVol == 0
    runtime.error("No volume is provided by the data vendor.")
src = close
obv = ta.cum(math.sign(ta.change(src)) * volume)
obv_plot = plot(obv, color=#2962FF, title="OnBalanceVolume")

ma(source, length, type) =>
    switch type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

typeMA = input.string(title = "Method", defval = "SMA", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Smoothing")
smoothingLength = input.int(title = "Length", defval = 20, minval = 1, maxval = 100, group="Smoothing")
obv_offset = input.int(title = "OBV MA Offset", defval = 9, minval = 1, maxval = 100, group="Smoothing")

smoothingLine = ma(obv, smoothingLength, typeMA)
smoothed_plot = plot(smoothingLine, title="Smoothing Line", color=#f37f20, display=display.all, offset = obv_offset)
fill(obv_plot, smoothed_plot, color = obv > smoothingLine[obv_offset] ? color.new(color.teal, 70) : color.new(color.red, 70))

