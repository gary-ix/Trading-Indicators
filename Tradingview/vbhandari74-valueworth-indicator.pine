// © goodgains

// ™valueworth91
//@version=4

study("vbhandari74 valueworth indicator", overlay=true)

// @keywords: valueworth, vbhandari74, amplitude-channel, channel-deviation, buy-sell-arrows, trend-flip, atr-channel, minimum-high, maximum-low, high-low-ma, candle-coloring, swing-detection, arrow-signals, trend-state, overlay-indicator, deviation-band, amplitude-pivot, valueworth-line, trend-arrow, channel-break

amplitude = input(title="Amplitude", defval=2)
channelDeviation = input(title="Channel Deviation", defval=2)
showArrows = input(title="Show Arrows", defval=true)
showValueworth= input(false,"Show Valueworth")
showMinHigh = input(true,"Show Minimum High")
showMaxLow = input(true,"Show Maximum Low")
showMAs = input(title="Show High Low MAs", defval=false)
showCandleColor=input(true,"Show Candle Color")

var int trend = 0
var int nextTrend = 0
var float maxLowPrice = nz(low[1], low)
var float minHighPrice = nz(high[1], high)

var float up = 0.0
var float down = 0.0
float atrHigh = 0.0
float atrLow = 0.0
float arrowUp = na
float arrowDown = na

atr2 = atr(100) / 2
dev = channelDeviation * atr2

highPrice = high[abs(highestbars(amplitude))]
lowPrice = low[abs(lowestbars(amplitude))]
highma = sma(high, amplitude)
lowma = sma(low, amplitude)

if nextTrend == 1
	maxLowPrice := max(lowPrice, maxLowPrice)

	if highma < maxLowPrice and close < nz(low[1], low)
		trend := 1
		nextTrend := 0
		minHighPrice := highPrice
else
	minHighPrice := min(highPrice, minHighPrice)

	if lowma > minHighPrice and close > nz(high[1], high)
		trend := 0
		nextTrend := 1
		maxLowPrice := lowPrice

if trend == 0
	if not na(trend[1]) and trend[1] != 0
		up := na(down[1]) ? down : down[1]
		arrowUp := up - atr2
	else
		up := na(up[1]) ? maxLowPrice : max(maxLowPrice, up[1])
	atrHigh := up + dev
	atrLow := up - dev
else
	if not na(trend[1]) and trend[1] != 1 
		down := na(up[1]) ? up : up[1]
		arrowDown := down + atr2
	else
		down := na(down[1]) ? minHighPrice : min(minHighPrice, down[1])
	atrHigh := down + dev
	atrLow := down - dev

ht = trend == 0 ? up : down

plot(showMaxLow?maxLowPrice:na,"Maximum Low",color.red,2)
plot(showMinHigh? minHighPrice : na,"Minimum High",color.green,2)

plot(showMAs?highma:na,"High SMA",color=color.blue)
plot(showMAs?lowma:na,"Low SMA",color=color.navy)

var color buyColor = color.green
var color sellColor = color.red

htColor = trend == 0 ? buyColor : sellColor
htPlot = plot(showValueworth ? ht : na, title="valueworth Indicator", linewidth=2, color=htColor)

buyFirstCndMet = lowma > minHighPrice and trend == 1 and not (close > nz(high[1], high))
sellFirstCndMet = highma < maxLowPrice and trend == 0 and not (close < nz(low[1], low))

//bgcolor( sellFirstCndMet ?color.new(color.green,50):na)

barColor = buyFirstCndMet or sellFirstCndMet ? color.yellow : trend == 0 ? color.green : trend == 1 ? color.red : na

barColorWithCheck = showCandleColor ? barColor : na


barcolor(barColorWithCheck)
plotcandle(open,high,low,close,"Candle Color",barColorWithCheck,barColorWithCheck,bordercolor=barColorWithCheck)

buySignal = not na(arrowUp) and (trend == 0 and trend[1] == 1)
sellSignal = not na(arrowDown) and (trend == 1 and trend[1] == 0)

plotshape(showArrows and buySignal  ? atrLow  : na, title="Buy",  text="Buy",  style=shape.labelup,   location=location.absolute, size=size.tiny, color=buyColor,   textcolor=color.white)
plotshape(showArrows and sellSignal ? atrHigh : na, title="Sell", text="Sell", style=shape.labeldown, location=location.absolute, size=size.tiny, color=sellColor,  textcolor=color.white)

alertcondition(buySignal,  title="Alert: valueworth Indicator Buy", message="valueworth Indicator Buy")
alertcondition(sellSignal, title="Alert: valueworth Indicator Sell", message="valueworth Indicator Sell")

var tbl = table.new(position.bottom_left, 2, 3, frame_color=#151715, frame_width=1, border_width=2, border_color=color.new(color.white, 100))

if barstate.islast
    
    buymode_col = trend == 0 ? #44f30b : #aaaaaa
    sellmode_col = trend == 1 ? color.red : #aaaaaa
    currentmod_col = trend == 0 ? #44f30b : color.red
    modecdn_txt = trend == 0 ? "BUY" : "SELL"
    item2_txt = trend == 0 ? "Sell First Condition" : "Buy First Condition"
    firstcdn_col = buyFirstCndMet or sellFirstCndMet ? color.yellow : #aaaaaa
    firstcdn_txt = trend == 0 ? tostring(maxLowPrice, "#.##") : tostring(minHighPrice, "#.##")
    firstcdn_txt_clr = trend == 0 ? color.red : color.green
    item3_txt = trend == 0 ? "Sell Second Condition" : "Buy Second Condition"
    secondcdn_txt = trend == 0 and sellFirstCndMet ? tostring(low[1], "#.##") : trend == 1 and buyFirstCndMet ? tostring(high[1], "#.##") : ""
    
    clsto_sell = sellFirstCndMet ? tostring(low[1], "#.##") : ""
    clsto_buy = buyFirstCndMet ? tostring(high[1], "#.##") : ""
    clsto_sell_bg = sellFirstCndMet ? color.red : #aaaaaa
    clsto_buy_bg = buyFirstCndMet ? color.green : #aaaaaa
    
    table.cell(tbl, 0, 0, "Current Mode",    text_halign = text.align_left,   bgcolor = color.gray, text_color = color.white, text_size = size.auto)
    table.cell(tbl, 0, 1, item2_txt, text_halign = text.align_left,   bgcolor = color.gray, text_color = color.white, text_size = size.auto)
    table.cell(tbl, 0, 2, item3_txt,    text_halign = text.align_left,   bgcolor = color.gray, text_color = color.white, text_size = size.auto)
    
    table.cell(tbl, 1, 0, modecdn_txt, text_halign = text.align_center, bgcolor = currentmod_col)
    // table.cell(tbl, 1, 1, firstcdn_txt, text_halign = text.align_center, bgcolor = firstcdn_col, text_color = firstcdn_txt_clr, text_size = size.auto)
    // table.cell(tbl, 1, 2, secondcdn_txt, text_halign = text.align_center, bgcolor = #aaaaaa, text_color = firstcdn_txt_clr, text_size = size.auto)

    table.cell(tbl, 1, 1, firstcdn_txt, text_halign = text.align_center, bgcolor = firstcdn_col, text_color = color.black, text_size = size.auto)
    table.cell(tbl, 1, 2, secondcdn_txt, text_halign = text.align_center, bgcolor = #aaaaaa, text_color = color.black, text_size = size.auto)




