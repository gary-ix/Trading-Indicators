//@version=5
indicator("Xact Internals", overlay = false)

// @keywords: xact-internals, market-internals-dashboard, multi-symbol-rsi, stocks-futures-crypto-forex, auto-mode-switch, internal-oscillator-panel, breadth-indicator-table, bb-channel-internals, spy-qqq-internals, percent-change-display, mobile-desktop-dashboard, rsi-50-smoothing, market-internal-rsi, cross-market-comparison, internals-table, bullish-bearish-markers, symbol-auto-detect, oscillator-dashboard, internal-breadth, mode-selection

// settings
mode = input.string('Auto', title = 'Mode', 
 options = ['Auto', 'Stocks', 'Futures', 'Crypto', 'Forex'],
 group = 'Settings', inline = '1',
 tooltip = 'Auto = Automatically switches symbol depending what symbol the chart is.')

color_up = input.color(color.new(#05cd0e,0), title='Bull Color', inline='3', group='Settings')
color_down = input.color(color.new(#b63632,0), title='Bear Color', inline='3', group='Settings')



// dashboard settings
dashboard_type = input.string('Mobile', title = 'Dashboard Settings', options = ['Desktop', 'Desktop Small', 'Mobile', 'Mobile Small'],
 inline = '74', group = 'Settings')

// functions
f_chartcolor() =>
    chart_r = color.r(chart.bg_color)
    chart_g = color.g(chart.bg_color)
    chart_b = color.b(chart.bg_color)

    lumina = math.sqrt(
     0.299 * (chart_r * chart_r) +
     0.587 * (chart_g * chart_g) +
     0.114 * (chart_b * chart_b)
     )

    is_dark = lumina < 127.5 ? true : false

f_color_adjust(input_color, factor, dark_mode) =>
    color_r = color.r(input_color)
    color_g = color.g(input_color)
    color_b = color.b(input_color)

    var int new_r = 0
    var int new_g = 0
    var int new_b = 0

    if dark_mode
        new_r := int(math.max(0, color_r * (1 - factor)))
        new_g := int(math.max(0, color_g * (1 - factor)))
        new_b := int(math.max(0, color_b * (1 - factor)))
    else
        new_r := int(color_r + (255 - color_r) * factor)
        new_g := int(color_g + (255 - color_g) * factor)
        new_b := int(color_b + (255 - color_b) * factor)

    new_color = color.rgb(new_r, new_g, new_b)

f_sc(symbol) =>
    [value, ticker] = request.security(symbol, "", [ta.rsi(close,50), syminfo.ticker], lookahead = barmerge.lookahead_on)

f_bb(src, length, mult, mult2, mult3, mult4) =>
    float basis = ta.sma(src, length)
    float dev =  ta.stdev(src, length)
    [basis, basis + dev * mult, basis - dev * mult,
     basis + dev * mult2, basis - dev * mult2,
     basis + dev * mult3, basis - dev * mult3,
     basis + dev * mult4, basis - dev * mult4]




// vars
var bool dark_mode      = f_chartcolor()
stock1  = "BATS:SPY"
future1 = "CAPITALCOM:US500"
crypto1 = "BINANCE:BTCUSDT"
forex1  = "FX:EURUSD"

stock2  = "BATS:QQQ"
future2 = "CAPITALCOM:US100"
crypto2 = "BINANCE:ETHUSDT"
forex2  = "FX:USDJPY"

stock3  = "BATS:IWM"
future3 = "CAPITALCOM:RTY"
crypto3 = "CRYPTOCAP:TOTAL"
forex3  = "FX:GBPUSD"

stock4  = "BATS:DIA"
future4 = "CAPITALCOM:US30"
crypto4 = "CRYPTOCAP:TOTALDEFI"
forex4  = "FX:USDCAD"



pct_chg(symbol) =>
    chg = request.security(symbol, "D", math.round((close - close[1]) / close[1] * 100,2), lookahead = barmerge.lookahead_on)
    chg_color = chg >= 0 ? f_color_adjust(color_up, .7, dark_mode) : f_color_adjust(color_down, .7, dark_mode)
    [chg, chg_color]
    
    
rating(number) =>
    return_rating = number > 70 ? (dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small' ? "OB" : "Overbought") 
     : number >= 60 ? (dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small' ? "Buy+" : "Strong Buy") 
     : number >= 50 ? "Buy" 
     : number < 20 ? (dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small' ? "OS" : "Oversold") 
     : number <= 40 ? (dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small' ? "Sell+" : "Strong Sell") 
     : number < 50 ? "Sell" 
     : " "

    return_color = number > 70 ? f_color_adjust(color_up, .5, dark_mode)
     : number >= 50 ? f_color_adjust(color_up, .7, dark_mode)
     : number < 20 ? f_color_adjust(color_down, .7, dark_mode)
     : number < 50 ? f_color_adjust(color_down, .5, dark_mode)
     : na
    [return_rating, return_color]



// calculate
[r1, r1_ticker] = f_sc(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex1
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto1
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future1
 : (mode == 'Auto') or mode == 'Stocks' ? stock1
 : stock1
 )
 
[r2, r2_ticker] = f_sc(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex2
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto2
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future2
 : (mode == 'Auto') or mode == 'Stocks' ? stock2
 : stock2
 )

[r3, r3_ticker] = f_sc(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex3
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto3
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future3
 : (mode == 'Auto') or mode == 'Stocks' ? stock3
 : stock3
 )


[r4, r4_ticker] = f_sc(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex4
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto4
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future4
 : (mode == 'Auto') or mode == 'Stocks' ? stock4
 : stock4
 )




avg = math.avg(r1,r2,r3,r4)
plot(avg, color = color.new(#000000,0), title = 'Internal Oscillator Outline', linewidth = 5, style = plot.style_line, editable = false)
avg_plot = plot(avg, color = avg > 50 ? color_up : color_down, title = 'Internal Oscillator', linewidth = 2, style = plot.style_line, editable = false)
midline = plot(50, color = color.new(color.gray,50), title = "Midline", editable = false)
bull_color = color.from_gradient(avg, ta.lowest(avg, 20), ta.highest(avg, 20), color.new(color_up,65), color_up)
bear_color = color.from_gradient(avg, ta.lowest(avg, 20), ta.highest(avg, 20), color_down, color.new(color_down,65))
fill(avg_plot, midline, color = avg > 50 ? bull_color : bear_color, editable = false)


[middle, upper, lower, upper2, lower2, upper3, lower3, upper4, lower4] = f_bb(avg, 200, 2.5 , 3.25, 4.00, 4.75)
upper_1 = plot(upper, title = 'Strong Overbought Reading', color = color.new(#d32f2f, 99),editable = false)
lower_1 = plot(lower, title = 'Strong Oversold Reading', color = color.new(#26a69a, 99),editable = false)
upper_2 = plot(upper2,title = 'Xtreme Overbought Reading', color = color.new(#d32f2f, 96),editable = false)
lower_2 = plot(lower2,title = 'Xtreme Oversold Reading', color = color.new(#26a69a, 96),editable = false)
upper_3 = plot(upper3, title = 'Strong Overbought Reading', color = color.new(#d32f2f, 93),editable = false)
lower_3 = plot(lower3, title = 'Strong Oversold Reading', color = color.new(#26a69a, 93),editable = false)
upper_4 = plot(upper4,title = 'Xtreme Overbought Reading', color = color.new(#d32f2f, 80),editable = false)
lower_4 = plot(lower4,title = 'Xtreme Oversold Reading', color = color.new(#26a69a, 80),editable = false)


fill(upper_1, upper_2, color = color.new(color_down,96), title = "Overbought Area", editable = false)
fill(lower_1, lower_2, color = color.new(color_up,96), title = "Oversold Area", editable = false)

fill(upper_2, upper_3, color = color.new(color_down,90), title = "Overbought Area", editable = false)
fill(upper_3, upper_4, color = color.new(color_down,85), title = "Overbought Area", editable = false)

fill(lower_2, lower_3, color = color.new(color_up,90), title = "Oversold Area", editable = false)
fill(lower_3, lower_4, color = color.new(color_up,85), title = "Oversold Area", editable = false)

[r1_chg, r1_chg_color] = pct_chg(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex1
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto1
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future1
 : (mode == 'Auto') or mode == 'Stocks' ? stock1
 : stock1
 )

[r2_chg, r2_chg_color] = pct_chg(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex2
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto2
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future2
 : (mode == 'Auto') or mode == 'Stocks' ? stock2
 : stock2
 )

[r3_chg, r3_chg_color] = pct_chg(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex3
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto3
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future3
 : (mode == 'Auto') or mode == 'Stocks' ? stock3
 : stock3
 )

[r4_chg, r4_chg_color] = pct_chg(
 (mode == 'Auto' and syminfo.type == 'forex') or mode == 'Forex' ? forex4
 : (mode == 'Auto' and syminfo.type == 'crypto') or mode == 'Crypto' ? crypto4
 : (mode == 'Auto' and syminfo.type == 'futures') or mode == 'Futures' ? future4
 : (mode == 'Auto') or mode == 'Stocks' ? stock4
 : stock4
 )

[r1_rating, r1_color] = rating(r1)
[r2_rating, r2_color] = rating(r2)
[r3_rating, r3_color] = rating(r3)
[r4_rating, r4_color] = rating(r4)



// table
var table_position      = position.middle_right
var table_size          = dashboard_type == 'Mobile' or dashboard_type == 'Desktop' ? size.small : size.tiny 
var color table_color   = chart.bg_color
var color table_text    = chart.fg_color
var color bull_text     = color_up
var color bear_text     = color_down
var table t             = table.new(table_position, 3, 6, 
 frame_color=color.new(table_text, 85), frame_width=1,
 border_color=color.new(table_text,0), border_width=0)
var color table_header_css = f_color_adjust(table_color, 0.6, dark_mode)


if barstate.islast

    table.clear(t,0,0,2,5)

    if dashboard_type == 'Desktop' or dashboard_type == 'Desktop Small'
        //Column 1
        table.cell(t, 0, 0, text='Xact Internals', width=0, bgcolor=table_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 1, text=' ', width=0, bgcolor=table_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 2, text=r1_ticker, width=0, bgcolor=r1_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 3, text=r2_ticker, width=0, bgcolor=r2_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 4, text=r3_ticker, width=0, bgcolor=r3_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 5, text=r4_ticker, width=0, bgcolor=r4_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        
        //Column2
        table.cell(t, 1, 1, text=' % Chg', width=0, bgcolor=table_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 2, text=str.tostring(r1_chg)+ "%", width=0, bgcolor=r1_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 3, text=str.tostring(r3_chg)+ "%", width=0, bgcolor=r3_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 4, text=str.tostring(r2_chg)+ "%", width=0, bgcolor=r2_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 5, text=str.tostring(r4_chg)+ "%", width=0, bgcolor=r4_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)

        //Column3
        table.cell(t, 2, 1, text=' Rating', width=0, bgcolor=table_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 2, text=r1_rating, width=0, bgcolor=r1_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 3, text=r3_rating, width=0, bgcolor=r3_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 4, text=r2_rating, width=0, bgcolor=r2_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 5, text=r4_rating, width=0, bgcolor=r4_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.merge_cells(t,0,0,2,0)


    if dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small'
        //Column 1
        table.cell(t, 0, 0, text='Xact', width=0, bgcolor=table_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 1, text=r1_ticker, width=0, bgcolor=r1_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 2, text=r2_ticker, width=0, bgcolor=r2_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 3, text=(r3_ticker == 'RTY' ? 'US2000' : r3_ticker), width=0, bgcolor=r3_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 0, 4, text=r4_ticker, width=0, bgcolor=r4_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        
        //Column2
        table.cell(t, 1, 1, text=str.tostring(r1_chg)+ "%", width=0, bgcolor=r1_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 2, text=str.tostring(r3_chg)+ "%", width=0, bgcolor=r3_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 3, text=str.tostring(r2_chg)+ "%", width=0, bgcolor=r2_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 1, 4, text=str.tostring(r4_chg)+ "%", width=0, bgcolor=r4_chg_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)

        //Column3
        table.cell(t, 2, 1, text=r1_rating, width=0, bgcolor=r1_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 2, text=r3_rating, width=0, bgcolor=r3_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 3, text=r2_rating, width=0, bgcolor=r2_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.cell(t, 2, 4, text=r4_rating, width=0, bgcolor=r4_color, text_color=table_text, text_size = table_size, text_halign=text.align_center)
        table.merge_cells(t,0,0,2,0)

