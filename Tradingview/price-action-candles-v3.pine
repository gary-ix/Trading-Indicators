//@version=5
indicator("Price Action Candles", overlay = true)

// @keywords: two-bar-low-swing, two-bar-high-swing, triangle-up-marker, triangle-down-marker, swing-low-pattern, swing-high-pattern, price-action-marker, consecutive-low-compare, consecutive-high-compare, reversal-cue, intraday-structure, bar-offset-plot, minimal-overlay, low-high-sequencing, pattern-recognition, dip-rally-flag, peak-drop-flag, simple-signals, no-oscillator, structure-hint

L = low
H = high

// twoup =  (L < L[-1]) and (L < L[1]) and (L[-1] < L[-2])
twoup = (L[2] < L[1]) and (L[2] < L[3]) and (L[1] < L)

// twodown =  (H > H[-1]) and (H > H[1]) 
twodown = (H[1] > H) and (H[1] > H[2])

plotshape(twoup, title = 'Two Up', location = location.belowbar, color = color.green, offset = -2, style = shape.triangleup)
plotshape(twodown, title = 'Two Down', location = location.abovebar, color = color.red, offset = -1, style = shape.triangledown)

