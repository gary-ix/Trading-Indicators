//@version=5
indicator("VWAP Stripped Down", overlay = true)

// @keywords: vwap-stripped-down, anchored-vwap, daily-weekly-monthly-vwap, quarter-year-anchor, hlc3-source-vwap, cumulative-volume-vwap, period-reset-vwap, single-vwap-line, volume-required-check, time-change-anchor, minimal-vwap-overlay, stripped-vwap-calc, anchor-period-switch, vwap-settings-group, overlay-vwap-plot, period-boundary-reset, volume-weighted-average, no-bands-vwap, simple-anchored-vwap, vendor-volume-check

//NO VOLUME ERROR CATCH 
var cumVol = 0.
cumVol += nz(volume)
if barstate.islast and cumVol == 0
    runtime.error("No volume is provided by the data vendor.")

//FUNCTIONS 
computeVWAP(src, isNewPeriod) =>
	var float sumSrcVol = na
	var float sumVol = na
    var float sumSrcSrcVol = na

	sumSrcVol := isNewPeriod ? src * volume : src * volume + sumSrcVol[1]
	sumVol := isNewPeriod ? volume : volume + sumVol[1]
	sumSrcSrcVol := isNewPeriod ? volume * math.pow(src, 2) : volume * math.pow(src, 2) + sumSrcSrcVol[1]
	_vwap = sumSrcVol / sumVol

	_vwap

timeChange(period) =>
	ta.change(time(period))

//COMPUTE VWAP
var anchor = input.string(defval = "Day", title="VWAP Period", options=["Day", "Week", "Month", "Quarter", "Year"], group="VWAP Settings", inline = '1')
src = input(title = "", defval = hlc3, group="VWAP Settings", inline = '1')

isNewPeriod = switch anchor
	"Day" => timeChange("D")
	"Week" => timeChange("W")
	"Month" => timeChange("M")
	"Quarter" => timeChange("3M")
	"Year" => timeChange("12M")
	=> false

if na(src[1]) 
	isNewPeriod := true

float vwapValue = na
_vwap = computeVWAP(src, isNewPeriod)
vwapValue := _vwap

plot(vwapValue, title="VWAP", color=#2962FF)


