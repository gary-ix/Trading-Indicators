BuySig = (alert_chart and buyS) or (alert_s1 and buySignal1) or (alert_s2 and buySignal2) or (alert_s3 and buySignal3) or (alert_s4 and buySignal4) or (alert_s5 and buySignal5) or (alert_s6 and buySignal6) or (alert_s7 and buySignal7) or (alert_s8 and buySignal8) or (alert_s9 and buySignal9) or (alert_s10 and buySignal10)
ExitBuy = (alert_chart and exitBuyS) or (alert_s1 and buyExitSignal1) or (alert_s2 and buyExitSignal2) or (alert_s3 and buyExitSignal3) or (alert_s4 and buyExitSignal4) or (alert_s5 and buyExitSignal5) or (alert_s6 and buyExitSignal6) or (alert_s7 and buyExitSignal7) or (alert_s8 and buyExitSignal8) or (alert_s9 and buyExitSignal9) or (alert_s10 and buyExitSignal10)
SellSig = (alert_chart and sellS) or (alert_s1 and sellSignal1) or (alert_s2 and sellSignal2) or (alert_s3 and sellSignal3) or (alert_s4 and sellSignal4) or (alert_s5 and sellSignal5) or (alert_s6 and sellSignal6) or (alert_s7 and sellSignal7) or (alert_s8 and sellSignal8) or (alert_s9 and sellSignal9) or (alert_s10 and sellSignal10)
ExitSell = (alert_chart and exitSellS) or (alert_s1 and sellExitSignal1) or (alert_s2 and sellExitSignal2) or (alert_s3 and sellExitSignal3) or (alert_s4 and sellExitSignal4) or (alert_s5 and sellExitSignal5) or (alert_s6 and sellExitSignal6) or (alert_s7 and sellExitSignal7) or (alert_s8 and sellExitSignal8) or (alert_s9 and sellExitSignal9) or (alert_s10 and sellExitSignal10)

longEntryMsg = (alert_chart and buyS)? chartLongEntry : (alert_s1 and buySignal1)? Long1Entry : (alert_s2 and buySignal2)? Long2Entry :  (alert_s3 and buySignal3)? Long3Entry : (alert_s4 and buySignal4)? Long4Entry : (alert_s5 and buySignal5)? Long5Entry : (alert_s6 and buySignal6)? Long6Entry : (alert_s7 and buySignal7) ? Long7Entry : (alert_s8 and buySignal8)? Long8Entry : (alert_s9 and buySignal9)? Long9Entry : (alert_s10 and buySignal10)? Long10Entry : ""
longExitMsg = (alert_chart and exitBuyS)? chartLongExit :  (alert_s1 and buyExitSignal1)? Long1Exit :  (alert_s2 and buyExitSignal2) ? Long2Exit : (alert_s3 and buyExitSignal3)? Long3Exit : (alert_s4 and buyExitSignal4) ? Long4Exit : (alert_s5 and buyExitSignal5)? Long5Exit :  (alert_s6 and buyExitSignal6)? Long6Exit : (alert_s7 and buyExitSignal7)? Long7Exit : (alert_s8 and buyExitSignal8)? Long8Exit :  (alert_s9 and buyExitSignal9)?Long9Exit : (alert_s10 and buyExitSignal10)?Long10Exit : ""
shortEntryMsg = (alert_chart and sellS)? chartShortEntry : (alert_s1 and sellSignal1)? Short1Entry :  (alert_s2 and sellSignal2)? Short2Entry : (alert_s3 and sellSignal3)? Short3Entry : (alert_s4 and sellSignal4)? Short4Entry : (alert_s5 and sellSignal5)? Short5Entry :(alert_s6 and sellSignal6)? Short6Entry : (alert_s7 and sellSignal7)? Short7Entry : (alert_s8 and sellSignal8)? Short8Entry : (alert_s9 and sellSignal9)? Short9Entry :  (alert_s10 and sellSignal10)? Short10Entry : ""
shortExitMsg = (alert_chart and exitSellS)? chartShortExit : (alert_s1 and sellExitSignal1)? Short1Exit : (alert_s2 and sellExitSignal2)? Short2Exit : (alert_s3 and sellExitSignal3)? Short3Exit :  (alert_s4 and sellExitSignal4)? Short4Exit : (alert_s5 and sellExitSignal5)? Short5Exit :  (alert_s6 and sellExitSignal6)? Short6Exit : (alert_s7 and sellExitSignal7)? Short7Exit : (alert_s8 and sellExitSignal8)? Short8Exit :(alert_s9 and sellExitSignal9)? Short9Exit : (alert_s10 and sellExitSignal10)? Short10Exit : ""

alert_type = closure == "Once Per Close" ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

if BuySig
    alert(longEntryMsg,alert_type)
if SellSig
    alert(shortEntryMsg,alert_type)
if ExitBuy
    alert(longExitMsg,alert_type)
if ExitSell
    alert(shortExitMsg,alert_type)



