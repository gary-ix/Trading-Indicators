// JL
//@version=5

indicator('Faith JL', shorttitle='Faith JL', format=format.volume, overlay=false, explicit_plot_zorder=true, precision=0)

// @keywords: faith-jl, faith-indicator, faith-grade, market-sentiment, buyer-seller-dominance, volume-expansion, hull-moving-average, hull-ma-agreement, aroon, aroon-crossover, buy-volume, sell-volume, volume-split, green-red-percent, atr-stop-loss, multi-symbol-scanner, buy-sell-signals, entry-exit-signals, volume-filter, volume-histogram

// My Indicator AROON START ===========   
LengthIndAroon = input.int(title='AROON Ind Length', defval=9, minval=1)
upper = 100 * (ta.highestbars(high, LengthIndAroon) + LengthIndAroon) / LengthIndAroon
lower = 100 * (ta.lowestbars(low, LengthIndAroon) + LengthIndAroon) / LengthIndAroon
buyAroon = ta.crossover(upper, lower)
sellAroon = ta.crossover(lower, upper)

BuyVolume = high == low ? 0 : volume * (close - low) / (high - low)
SellVolume = high == low ? 0 : volume * (high - close) / (high - low)   
// My Indicator AROON END ===========  
   
   
//==============================================================================
//                    ATR SL INDICATOR START
//==============================================================================
length = input.int(title='ATR Length', defval=14, minval=1, group='--- ATR SL Indicator ---')
smoothing = input.string(title='ATR Smoothing', defval='RMA', options=['RMA', 'SMA', 'EMA', 'WMA'], group='--- ATR SL Indicator ---')
m = input(0.35, 'ATR Multiplier', group='--- ATR SL Indicator ---')
src1 = input(high)
src2 = input(low)
pline = input(false, 'Show Price Lines')

ma_function(source, length) =>
    if smoothing == 'RMA'
        ta.rma(source, length)
    else
        if smoothing == 'SMA'
            ta.sma(source, length)
        else
            if smoothing == 'EMA'
                ta.ema(source, length)
            else
                ta.wma(source, length)

a = ma_function(ta.tr(true), length) * m
x = ma_function(ta.tr(true), length) * m + src1
x2 = src2 - ma_function(ta.tr(true), length) * m

//===============================================================
//----- Buy Condition Controls
cl_green = input(true,"Green",group="Buy Condition Controls",inline="a")
cl_vol = input(true,"Volume",group="Buy Condition Controls",inline="a")
cl_minPerc = input(true,"minPerc",group="Buy Condition Controls",inline="a")
cl_maxPerc = input(true,"maxPerc",group="Buy Condition Controls",inline="a")
cl_faith = input(true,"Faith",group="Buy Condition Controls",inline="a")
cl_aroon = input(true,"Aroon",group="Buy Condition Controls",inline="a")

//----- Sell Condition Controls
cs_red = input(true,"Red",group="Sell Condition Controls",inline="a")
cs_vol = input(true,"Volume",group="Sell Condition Controls",inline="a")
cs_minPerc = input(true,"minPerc",group="Sell Condition Controls",inline="a")
cs_maxPerc = input(true,"maxPerc",group="Sell Condition Controls",inline="a")
cs_faith = input(true,"Faith",group="Sell Condition Controls",inline="a")
cs_aroon = input(true,"Aroon",group="Sell Condition Controls",inline="a")

//==============================================================================
//----- getting volume limit parameter inputs
volumeLimit = input.int(999999, 'Volume Limit for chart',group='--- volume limit parameter ---')
volumeLimit1 = input.int(100, 'Volume Limit for symbol 1',group='--- volume limit parameter ---')
volumeLimit2 = input.int(100, 'Volume Limit for symbol 2',group='--- volume limit parameter ---')
volumeLimit3 = input.int(100, 'Volume Limit for symbol 3',group='--- volume limit parameter ---')
volumeLimit4 = input.int(100, 'Volume Limit for symbol 4',group='--- volume limit parameter ---')
volumeLimit5 = input.int(100, 'Volume Limit for symbol 5',group='--- volume limit parameter ---')
volumeLimit6 = input.int(100, 'Volume Limit for symbol 6',group='--- volume limit parameter ---')
volumeLimit7 = input.int(100, 'Volume Limit for symbol 7',group='--- volume limit parameter ---')
volumeLimit8 = input.int(100, 'Volume Limit for symbol 8',group='--- volume limit parameter ---')
volumeLimit9 = input.int(100, 'Volume Limit for symbol 9',group='--- volume limit parameter ---')
volumeLimit10 = input.int(100, 'Volume Limit for symbol 10',group='--- volume limit parameter ---')

//----- getting MIN % limit parameter inputs
MinPerc = input.int(100,      'Min Limit for chart',group='--- MIN % limit parameter ---')
MinPerc1 = input.int(1,     'Min Limit for symbol 1',group='--- MIN % limit parameter ---')
MinPerc2 = input.int(1,     'Min Limit for symbol 2',group='--- MIN % limit parameter ---')
MinPerc3 = input.int(1,     'Min Limit for symbol 3',group='--- MIN % limit parameter ---')
MinPerc4 = input.int(1,     'Min Limit for symbol 4',group='--- MIN % limit parameter ---')
MinPerc5 = input.int(1,     'Min Limit for symbol 5',group='--- MIN % limit parameter ---')
MinPerc6 = input.int(1,     'Min Limit for symbol 5',group='--- MIN % limit parameter ---')
MinPerc7 = input.int(1,     'Min Limit for symbol 7',group='--- MIN % limit parameter ---')
MinPerc8 = input.int(1,     'Min Limit for symbol 8',group='--- MIN % limit parameter ---')
MinPerc9 = input.int(1,     'Min Limit for symbol 9',group='--- MIN % limit parameter ---')
MinPerc10 = input.int(1,    'Min Limit for symbol 10',group='--- MIN % limit parameter ---')

//----- getting MAX % limit parameter inputs
MaxPerc = input.int(0,    'Max Limit for chart',group='--- MAX % limit parameter ---')
MaxPerc1 = input.int(100,   'Max Limit for symbol 1',group='--- MAX % limit parameter ---')
MaxPerc2 = input.int(100,   'Max Limit for symbol 2',group='--- MAX % limit parameter ---')
MaxPerc3 = input.int(100,   'Max Limit for symbol 3',group='--- MAX % limit parameter ---')
MaxPerc4 = input.int(100,   'Max Limit for symbol 4',group='--- MAX % limit parameter ---')
MaxPerc5 = input.int(100,   'Max Limit for symbol 5',group='--- MAX % limit parameter ---')
MaxPerc6 = input.int(100,   'Max Limit for symbol 6',group='--- MAX % limit parameter ---')
MaxPerc7 = input.int(100,   'Max Limit for symbol 7',group='--- MAX % limit parameter ---')
MaxPerc8 = input.int(100,   'Max Limit for symbol 8',group='--- MAX % limit parameter ---')
MaxPerc9 = input.int(100,   'Max Limit for symbol 9',group='--- MAX % limit parameter ---')
MaxPerc10 = input.int(100,  'Max Limit for symbol 10',group='--- MAX % limit parameter ---')

//==============================================================================
//                    FAITH INDICATOR START
//==============================================================================
per = input(title='Faith Periods for Averaging', defval=10, group='--- FAITH Indicator ---')
fm = input(200, 'Faith Multiplier', group='--- FAITH Indicator ---')
fd= input(30, 'Faith LookBack Days', group='--- FAITH Indicator ---')
//Backgroud colors taken from Hull Moving Average Agreement Indicator (Hullag)
fa = input(20, 'Faith Number of periods for fast HullMA', group='--- FAITH Indicator ---')
fb = input(25, 'Faith Number of periods for slow HullMA', group='--- FAITH Indicator ---')
fc = input(0.1, 'Faith Min ATR difference required to call the MA a trend', group='--- FAITH Indicator ---')
ft = input(30, 'Faith Calculate min ATR as a kind of tangent', group='--- FAITH Indicator ---')


up = high > high[1] and volume > volume[1]  //Buyers volume when both higher high and more volume
down = low < low[1] and volume > volume[1]  //Sellers volume when both lower low and more volume
vproc = volume / ta.highest(volume, fd) * fm  //Used for calculation of volume expansion in a kind of percentage
volup = up ? vproc : 0  //Entered in the series of Buyers volume
voldown = down ? vproc : 0  //Entered in the series of Sellers volume

maup = ta.sma(volup, per)  //Average Buyers volume, sma and 10 periods seem to work best
madown = ta.sma(voldown, per)  //Average Sellers volume

difvol = maup - madown  //Faith of the market, i.e. buyers dominate the volume or sellers dominate it
u1 = difvol > 60 ? 8 : 0  //Very high faith graduated as 8
u2 = difvol > 40 and difvol <= 60 ? 6 : 0  //High faith as 6
u3 = difvol > 20 and difvol <= 40 ? 4 : 0  //Good faith as 4
u4 = difvol > 10 and difvol <= 20 ? 2 : 0  //Some Faith as 2
u5 = difvol > 0 and difvol <= 10 ? 1 : 0  //Little Faith as 1
d1 = difvol < -60 ? -8 : 0  //Very High mistrust graduated as -8    
d2 = difvol < -40 and difvol >= -60 ? -6 : 0  //High Mistrust as -6
d3 = difvol < -20 and difvol >= -40 ? -4 : 0  //Bad Mistrust as -4 
d4 = difvol < -10 and difvol >= -20 ? -2 : 0  //Some Mistrust as -2
d5 = difvol < 0 and difvol >= -10 ? -1 : 0  //Little Mistrust as -1
dif = u1 + u2 + u3 + u4 + u5 + d1 + d2 + d3 + d4 + d5  //Grades are either zero or something, adding them all up gives the grade in this instance

fhl = fa     //number of periods for fast Hull ma
shl = fb     //number of periods for slow Hull ma
trnd = fc    //minimum ATR difference required to call the ma a trend
istrend = trnd * ta.atr(ft)  //Calculate minimum ATR as a kind of tangent

fh = ta.hma(close, fhl)  //fast Hull Moving Average
fangle = fh[0] - fh[1]  //angle of fast hull slope calculated as a kind of tangent
var ftrend = 0  //initialise fast trend graduation
ftrend := fangle > istrend ? 1 : fangle < -istrend ? -1 : 0  //fast trend either 1, 0 or -1 meaning uptrend, no trend, down trend

sh = ta.hma(close, shl)  //slow Hull Moving Average
sangle = sh[0] - sh[1]  //angle of slow hull slope as a kind of tangent
var strend = 0  // initialise slow trend graduation
strend := sangle > istrend ? 1 : sangle < -istrend ? -1 : 0  //slow trend either 1, 0 or -1 meaning uptrend, no trend, down trend

hullag = ftrend + strend  //possible graduations are 2, 1, 0, -1, -2

bg2 = color.new(color.blue, 65)  //color when both hma agree on up trend, i.e. grade 2
bg1 = color.new(color.green, 75)  //color when one hma has up trend, one no trend, i.e. grade 1
bg0 = color.new(color.silver, 85)  //color when either both hma have no trend or have opposite trend, i.e. grad zero
bgm1 = color.new(color.maroon, 80)  //color when one hma has down trend, one no trend, i.e. grade -1
bgm2 = color.new(color.red, 65)  // color when both hma agree on down trend, i.e. grade -2
bgcolor(hullag == 2 ? bg2 : hullag == 1 ? bg1 : hullag == 0 ? bg0 : hullag == -1 ? bgm1 : bgm2, transp=90)

// PLOT Faith Histogram
plot(dif, 'FAITH Grade of Faith', dif > 0 ? color.blue : color.red, style=plot.style_circles, linewidth=5, transp=0)

//                    FAITH INDICATOR END
//==============================================================================


//----------------------------------------
//----- getting symbols input
symbol1 = input.symbol("BINANCE:ADAUSDT",'symbol 1', group = '--- symbols to scan ---')
symbol2 = input.symbol("BINANCE:ANKRUSDT",'symbol 2', group = '--- symbols to scan ---')
symbol3 = input.symbol("BINANCE:BTCUSDT",'symbol 3', group = '--- symbols to scan ---')
symbol4 = input.symbol("BINANCE:CHZUSDT",'symbol 4', group = '--- symbols to scan ---')
symbol5 = input.symbol("BINANCE:ETHUSDT",'symbol 5', group = '--- symbols to scan ---')
symbol6 = input.symbol("BINANCE:SHIBUSDT",'symbol 6', group = '--- symbols to scan ---')
symbol7 = input.symbol("BINANCE:TRXUSDT",'symbol 7', group = '--- symbols to scan ---')
symbol8 = input.symbol("BINANCE:XLMUSDT",'symbol 8', group = '--- symbols to scan ---')
symbol9 = input.symbol("BINANCE:XMRUSDT",'symbol 9', group = '--- symbols to scan ---')
symbol10 = input.symbol("BINANCE:XRPUSDT",'symbol 10', group = '--- symbols to scan ---')


//  Contains the script logic for buy and sell => returns 4 alert signals
get_Sig(volumeLimit,minPerc,maxPerc) =>
    // START CALC Percent calculation G/R over R/G and AROON indicator and Faith indicator
    tv = volume == 0 ? 1 : volume
    BuyVolume = high == low ? 0 : volume * (close - low) / (high - low)
    SellVolume = high == low ? 0 : volume * (high - close) / (high - low)
    
    PercG = BuyVolume * 100 / (BuyVolume + SellVolume)
    PercR = SellVolume * 100 / (BuyVolume + SellVolume)
    RozdielPercGminR = PercG - PercR
    RozdielPercRminG = PercR - PercG
    // END CALC percent 
    
    /// Aroon Data
    upper = 100 * (ta.highestbars(high, LengthIndAroon) + LengthIndAroon) / LengthIndAroon
    lower = 100 * (ta.lowestbars(low, LengthIndAroon) + LengthIndAroon) / LengthIndAroon
    buyAroon = ta.crossover(upper, lower)
    sellAroon = ta.crossover(lower, upper)
    
    /// Faith Data
    
    up = high > high[1] and volume > volume[1]  //Buyers volume when both higher high and more volume
    down = low < low[1] and volume > volume[1]  //Sellers volume when both lower low and more volume
    vproc = volume / ta.highest(volume, fd) * fm  //Used for calculation of volume expansion in a kind of percentage
    volup = up ? vproc : 0  //Entered in the series of Buyers volume
    voldown = down ? vproc : 0  //Entered in the series of Sellers volume
    
    maup = ta.sma(volup, per)  //Average Buyers volume, sma and 10 periods seem to work best
    madown = ta.sma(voldown, per)  //Average Sellers volume
    
    difvol = maup - madown  //Faith of the market, i.e. buyers dominate the volume or sellers dominate it
    u1 = difvol > 60 ? 8 : 0  //Very high faith graduated as 8
    u2 = difvol > 40 and difvol <= 60 ? 6 : 0  //High faith as 6
    u3 = difvol > 20 and difvol <= 40 ? 4 : 0  //Good faith as 4
    u4 = difvol > 10 and difvol <= 20 ? 2 : 0  //Some Faith as 2
    u5 = difvol > 0 and difvol <= 10 ? 1 : 0  //Little Faith as 1
    d1 = difvol < -60 ? -8 : 0  //Very High mistrust graduated as -8    
    d2 = difvol < -40 and difvol >= -60 ? -6 : 0  //High Mistrust as -6
    d3 = difvol < -20 and difvol >= -40 ? -4 : 0  //Bad Mistrust as -4 
    d4 = difvol < -10 and difvol >= -20 ? -2 : 0  //Some Mistrust as -2
    d5 = difvol < 0 and difvol >= -10 ? -1 : 0  //Little Mistrust as -1
    dif = u1 + u2 + u3 + u4 + u5 + d1 + d2 + d3 + d4 + d5  //Grades are either zero or something, adding them all up gives the grade in this instance
    
    fhl = fa     //number of periods for fast Hull ma
    shl = fb     //number of periods for slow Hull ma
    trnd = fc    //minimum ATR difference required to call the ma a trend
    istrend = trnd * ta.atr(ft)  //Calculate minimum ATR as a kind of tangent
    
    fh = ta.hma(close, fhl)  //fast Hull Moving Average
    fangle = fh[0] - fh[1]  //angle of fast hull slope calculated as a kind of tangent
    var ftrend = 0  //initialise fast trend graduation
    ftrend := fangle > istrend ? 1 : fangle < -istrend ? -1 : 0  //fast trend either 1, 0 or -1 meaning uptrend, no trend, down trend
    
    sh = ta.hma(close, shl)  //slow Hull Moving Average
    sangle = sh[0] - sh[1]  //angle of slow hull slope as a kind of tangent
    var strend = 0  // initialise slow trend graduation
    strend := sangle > istrend ? 1 : sangle < -istrend ? -1 : 0  //slow trend either 1, 0 or -1 meaning uptrend, no trend, down trend
    
    hullag = ftrend + strend  //possible graduations are 2, 1, 0, -1, -2
    
    buyFaith = (difvol > 10) and (hullag == 2)
    sellFaith = (difvol < -10) and (hullag == -2)
    
    ////

    var pos = 0
    var sl = 0.0
    buySig = false
    sellSig = false
    exitBuySig = false
    exitSellSig = false
    
    a = ma_function(ta.tr(true), length) * m
    x = ma_function(ta.tr(true), length) * m + src1
    x2 = src2 - ma_function(ta.tr(true), length) * m
    
    longSl = x2
    shortSl = x
    
    //Buy Conditions
    lGreen = cl_green?  close > open : true
    lVolume = cl_vol? volume > volumeLimit : true
    lPercRange = (cl_minPerc ?(RozdielPercGminR >= minPerc) : true) and (cl_maxPerc? (RozdielPercGminR <= maxPerc) : true)
    lFaith = cl_faith? buyFaith : true
    lAroon = cl_aroon? buyAroon : true
    allLDisabled = not cl_green and not cl_vol and not cl_minPerc and not maxPerc and not cl_faith and not cl_aroon
    
    // ======= MY BUY CONDITIONS =========
    buy = lGreen and lVolume and lPercRange and lFaith and lAroon and not allLDisabled
    
    if buy //and pos!=1
        pos := 1
        sl := longSl
        buySig := true
    
    //Sell Conditions
    sRed = cs_red?  (close < open) : true
    sVolume = cs_vol? (volume > volumeLimit) : true
    sPercRange = (cs_minPerc ?(RozdielPercRminG >= minPerc) : true) and (cs_maxPerc? (RozdielPercRminG <= maxPerc) : true)
    sFaith = cs_faith? sellFaith  : true
    sAroon = cs_aroon? sellAroon : true
    allSDisabled = not cs_red and not cs_vol and not cs_minPerc and not cs_maxPerc and not cs_faith and not cs_aroon
    
// ======= MY SELL CONDITIONS =========
    sell = sRed and sVolume and sPercRange and sFaith and sAroon and not allSDisabled
    if sell //and pos != -1 //Replace "false" with your short position
        pos := -1
        sl := shortSl
        sellSig := true
    
    
    if pos == 1 
        if low < sl
            pos := 0
            exitBuySig := true
    
    if pos == -1
        if high > sl
            pos := 0
            exitSellSig := true
            
    
    [buySig,sellSig,exitBuySig,exitSellSig]

/////////////// Calculating get_Sig() for current chart 

volL = volumeLimit
mnPerc =  MinPerc
mxPerc =  MaxPerc
// Line symbol 1
if ((syminfo.tickerid == symbol1) or (syminfo.tickerid == ticker.heikinashi(symbol1)))    // Check if current ticker is whatever selected in symbol 1
    volL := volumeLimit1
    mnPerc :=  MinPerc1
    mxPerc :=  MaxPerc1
// Line symbol 2
if ((syminfo.tickerid == symbol2) or (syminfo.tickerid == ticker.heikinashi(symbol2)))   
    volL := volumeLimit2
    mnPerc :=  MinPerc2
    mxPerc :=  MaxPerc2

// Line symbol 3
if ((syminfo.tickerid == symbol3) or (syminfo.tickerid == ticker.heikinashi(symbol3)))   
    volL := volumeLimit3
    mnPerc :=  MinPerc3
    mxPerc :=  MaxPerc3

// Line symbol 4
if ((syminfo.tickerid == symbol4) or (syminfo.tickerid == ticker.heikinashi(symbol4)))   
    volL := volumeLimit4
