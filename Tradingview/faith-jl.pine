// Line symbol 9
if ((syminfo.tickerid == symbol9) or (syminfo.tickerid == ticker.heikinashi(symbol9)))   
    volL := volumeLimit9
    mnPerc :=  MinPerc9
    mxPerc :=  MaxPerc9

// Line symbol 10
if ((syminfo.tickerid == symbol10) or (syminfo.tickerid == ticker.heikinashi(symbol10)))   
    volL := volumeLimit10
    mnPerc :=  MinPerc10
    mxPerc :=  MaxPerc10

plot(volL)
[buyS,sellS,exitBuyS,exitSellS] = get_Sig(volL,mnPerc,mxPerc)

// FINAL indicator START SIGNS 
plotshape(buyS, location=location.top, title='BUY', style=shape.triangleup, size=size.tiny, color=color.new(color.green, 0))
plotshape(sellS, location=location.top, title='SELL', style=shape.triangledown, size=size.tiny, color=color.new(color.red, 0))
plotshape(exitBuyS, location=location.top, title='Exit BUY', style=shape.xcross, size=size.tiny, color=color.new(color.green, 0))
plotshape(exitSellS, location=location.top, title='Exit SELL', style=shape.xcross, size=size.tiny, color=color.new(color.red, 0))
// FINAL indicator END SIGNS 


//----------------------------------------
barmergeGapsI = input.bool(false, "Gaps") ? barmerge.gaps_on : barmerge.gaps_off
barmergeLookaheadI = input.bool(true, "Lookahead") ? barmerge.lookahead_on : barmerge.lookahead_off

//////////////// calculating get_sig() for all selected symbols to be notified when there is an alert    NOT SURE IF BUYFAITH SHOULD BE HERE
[buySignal1,sellSignal1,buyExitSignal1,sellExitSignal1] = request.security(symbol1, timeframe.period, get_Sig(volumeLimit1,MinPerc1,MaxPerc1), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal2,sellSignal2,buyExitSignal2,sellExitSignal2] = request.security(symbol2, timeframe.period, get_Sig(volumeLimit2,MinPerc2,MaxPerc2), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal3,sellSignal3,buyExitSignal3,sellExitSignal3] = request.security(symbol3, timeframe.period, get_Sig(volumeLimit3,MinPerc3,MaxPerc3), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal4,sellSignal4,buyExitSignal4,sellExitSignal4] = request.security(symbol4, timeframe.period, get_Sig(volumeLimit4,MinPerc4,MaxPerc4), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal5,sellSignal5,buyExitSignal5,sellExitSignal5] = request.security(symbol5, timeframe.period, get_Sig(volumeLimit5,MinPerc5,MaxPerc5), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal6,sellSignal6,buyExitSignal6,sellExitSignal6] = request.security(symbol6, timeframe.period, get_Sig(volumeLimit6,MinPerc6,MaxPerc6), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal7,sellSignal7,buyExitSignal7,sellExitSignal7] = request.security(symbol7, timeframe.period, get_Sig(volumeLimit7,MinPerc7,MaxPerc7), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal8,sellSignal8,buyExitSignal8,sellExitSignal8] = request.security(symbol8, timeframe.period, get_Sig(volumeLimit8,MinPerc8,MaxPerc8), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal9,sellSignal9,buyExitSignal9,sellExitSignal9] = request.security(symbol9, timeframe.period, get_Sig(volumeLimit9,MinPerc9,MaxPerc9), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)
[buySignal10,sellSignal10,buyExitSignal10,sellExitSignal10] = request.security(symbol10, timeframe.period, get_Sig(volumeLimit10,MinPerc10,MaxPerc10), gaps=barmergeGapsI, lookahead=barmergeLookaheadI)



// // AROON indicator START signs 
plotshape(buyAroon, location=location.top, title='Aroon Buy', style=shape.diamond, size=size.tiny, color=color.new(color.yellow, 0 ))
plotshape(sellAroon, location=location.top, title='Aroon Sell', style=shape.diamond, size=size.tiny, color=color.new(color.orange, 0))
// // AROON indicator END signs 

//------------------------------------------
//----- to store the list of symbols as per their entries
entrySignalsLabel = "Entry Signals \n"
exitSignalsLabel = "Exit Signals \n"

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/- // symbol 1
//symbol wise checking of posiiton
//entering the trade

if buySignal1 and symbol1 != ""
    entrySignalsLabel := entrySignalsLabel + symbol1 + "\n"
    
// exiting the trade
if buyExitSignal1 and symbol1 != ""
    exitSignalsLabel := exitSignalsLabel + symbol1 + "\n"

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/- // symbol 2
if buySignal2 and symbol2 != ""
    entrySignalsLabel := entrySignalsLabel + symbol2 + "\n"

if buyExitSignal2 and symbol2 != ""
    exitSignalsLabel := exitSignalsLabel + symbol2 + "\n"


//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/- // symbol 3
if buySignal3 and symbol3 != ""
    entrySignalsLabel := entrySignalsLabel + symbol3 + "\n"

if buyExitSignal3 and symbol3 != ""
    exitSignalsLabel := exitSignalsLabel + symbol3 + "\n"


//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/- // symbol 4
if buySignal4 and symbol4 != ""
    entrySignalsLabel := entrySignalsLabel + symbol4 + "\n"

if buyExitSignal4 and symbol4 != ""
    exitSignalsLabel := exitSignalsLabel + symbol4 + "\n"


