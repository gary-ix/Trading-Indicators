//@version=5
indicator("Stoch Slow")

// @keywords: stoch-slow, slow-stochastic, stoch-k-line, stoch-d-smoothing, k-period-input, d-period-input, overbought-level, oversold-level, mid-alert-level, stochastic-oscillator, sma-stoch-smoothing, panel-plots, slow-stoch-settings, level-hlines, percent-k-calc, percent-d-calc, lower-pane-oscillator, stoch-level-markers, dual-k-plot, threshold-lines

//STOCH
stoch_kperiod = input.int(10, title = 'K Period', group = 'Stoch Settings')
stoch_dperiod = input.int(10, title = 'D Period', group = 'Stoch Settings')
stoch_overbought = input(80, title = 'Overbought', group = 'Stoch Settings')
stoch_mid = input(50, title = 'Other Alert Level', group = 'Stoch Settings')
stoch_oversold = input(20, title = 'Oversold', group = 'Stoch Settings')

stoch_k = ta.sma(ta.stoch(close, high, low, 3), stoch_kperiod)
stoch_d = ta.sma(stoch_k, stoch_dperiod)

plot(stoch_k)
plot(stoch_k)
plot(stoch_overbought)
plot(stoch_mid)
plot(stoch_oversold)



