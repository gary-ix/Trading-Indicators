//@version=5
strategy("RSI MA Scalp Strategy", overlay = true)

// @keywords: rsi-overbought-entry, rsi-oversold-entry, fast-slow-sma, five-minute-scalp, long-on-rsi70, short-on-rsi30, dual-ma-confirmation, strategy-overlay-plots, momentum-scalp-rules, rsi14-default, sma5-sma20, simple-entry-logic, rsi-ma-confluence, scalp-strategy-backtest, ma-trend-alignment, intraday-scalp-setup, rsi-threshold-gates, strategy-long-short, no-exit-rules, basic-rsi-strategy


// This script is for scalp trading on a 5-minute time frame

// Define the time frame and the RSI period
timeframe = "5"
rsiPeriod = 14

// Get the close price and the RSI value
rsiValue = ta.rsi(close, rsiPeriod)

// Define the moving averages
fastMA = ta.sma(close, 5)
slowMA = ta.sma(close, 20)

// Buy signal: RSI above 70 and fast MA crosses above slow MA
if rsiValue > 70 and fastMA > slowMA
    strategy.entry("Long", strategy.long)

// Sell signal: RSI below 30 and fast MA crosses below slow MA
if rsiValue < 30 and fastMA < slowMA
    strategy.entry("Short", strategy.short)

// Plot the RSI and moving averages
plot(rsiValue, title="RSI")
plot(fastMA, title="Fast MA")
plot(slowMA, title="Slow MA")

