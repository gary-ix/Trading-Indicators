fill(usa_lb_plot, usa_lb2_plot, color = usa_change ? color.new(usa_color,100) : color.new(usa_color,80), editable = false)


// SESSION STATS
var table_position = position == 'Right Top' ? position.top_right 
 : position == 'Right Middle' ? position.middle_right 
 : position == 'Right Bottom' ? position.bottom_right 
 : position == 'Center Bottom' ? position.bottom_center 
 : position == 'Center Top' ? position.top_center
 : position == 'Left Bottom' ? position.bottom_left 
 : position == 'Left Middle' ? position.middle_left
 : position.middle_right
var table_size = dashboard_type == 'Mobile' or dashboard_type == 'Desktop' ? size.small : size.tiny 
var color table_color = chart.bg_color
var color table_text = chart.fg_color
var color bull_text = dark_mode ? color.new(#05cd0e,0) : color.new(#1b5e20,0)
var color bear_text = dark_mode ? color.new(#ff4c5b, 0) : color.new(#801922,0)
var table t = table.new(table_position, 5, 20, 
 frame_color=color.new(table_text, 85), frame_width=1,
 border_color=color.new(table_text,92), border_width=0)

var color table_header_css = f_color_adjust(table_color, 0.6, dark_mode)
var color table_asia_css = f_color_adjust(asia_color, 0.70, dark_mode)
var color table_euro_css = f_color_adjust(euro_color, 0.70, dark_mode)
var color table_usa_css = f_color_adjust(usa_color, 0.70, dark_mode)

f_or_define(is_sess, is_or, orh, orl, vwap) =>

    var string sess_type_text = na
    var float or_mid = 0.00

    or_mid := (orh+orl) / 2

    if is_sess
        if is_or
            sess_type_text := ' '
        else
            sess_type_text := close > orh and close > vwap ? "Bullish+"
             : close > or_mid and close > vwap ? "Bullish"
             : close < orl and close < vwap ? "Bearish+"
             : close < or_mid and close < vwap ? "Bearish"
             : "Neutral"
    else
        sess_type_text := sess_type_text[1]

    sess_type_text


asia_sess_type_text = f_or_define(is_asia, not asia_or, asia_orh, asia_orl, asia_vwap)
euro_sess_type_text = f_or_define(is_euro, not euro_or, euro_orh, euro_orl, euro_vwap)
usa_sess_type_text = f_or_define(is_usa, not usa_or, usa_orh, usa_orl, usa_vwap)


if barstate.islast and show_stats
    current_session_color = is_asia ? asia_color
     : is_euro ? euro_color
     : is_usa ? usa_color
     : na

    current_session_text= is_asia ? 'Asia'
     : is_euro ? 'Euro'
     : is_usa ? 'USA'
     : na
    table.clear(t, 0,0,4,19)

    if dashboard_type == 'Desktop' or dashboard_type == 'Desktop Small'
        table.cell(t, 0, 0, text = 'Current Session - ' + current_session_text,
         text_size = table_size, text_color = table_text, bgcolor = table_header_css)
        table.merge_cells(t,0,0,2,0)

        table.cell(t, 0, 1, text = "Today's Values",
         text_size = table_size, text_color = color.new(table_text,30), bgcolor = table_header_css)
        table.merge_cells(t,0,1,1,1)

        table.cell(t, 2, 1, text = "Avg Values",
         text_size = table_size, text_color = color.new(table_text,30), bgcolor = table_header_css)
        table.merge_cells(t,2,1,2,1)

        if is_asia or not only_show_current_session_stats
            table.cell(t, 0, 2, text = '𝘼𝙨𝙞𝙖 𝙎𝙩𝙖𝙩𝙨 - ' + str.tostring(asia_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_asia_css)
            table.merge_cells(t,0,2,2,2)

            table.cell(t, 0, 3, text = 'H/L Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_asia_css)
            table.cell(t, 1, 3, str.tostring(math.round_to_mintick(asia_h - asia_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 3, str.tostring(math.round_to_mintick(sum_asia_ranges/num_asia_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)

            table.cell(t, 0, 4, text = 'OR Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_asia_css)
            table.cell(t, 1, 4, str.tostring(math.round_to_mintick(asia_orh-asia_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 4, str.tostring(math.round_to_mintick(sum_asia_or_ranges/num_asia_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)

            table.cell(t, 0, 5, text = 'Volume',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_asia_css)
            table.cell(t, 1, 5, str.tostring(asia_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 5, str.tostring(sum_asia_volume/num_asia_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)



        if is_euro or not only_show_current_session_stats
            table.cell(t, 0, 6, text = '𝙀𝙪𝙧𝙤 𝙎𝙩𝙖𝙩𝙨 - ' + str.tostring(euro_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_euro_css)
            table.merge_cells(t,0,6,2,6)

            table.cell(t, 0, 7, text = 'H/L Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_euro_css)
            table.cell(t, 1, 7, str.tostring(math.round_to_mintick(euro_h - euro_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)
            table.cell(t, 2, 7, str.tostring(math.round_to_mintick(sum_euro_ranges/num_euro_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)

            table.cell(t, 0, 8, text = 'OR Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_euro_css)
            table.cell(t, 1, 8, str.tostring(math.round_to_mintick(euro_orh-euro_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)
            table.cell(t, 2, 8, str.tostring(math.round_to_mintick(sum_euro_or_ranges/num_euro_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)

            table.cell(t, 0, 9, text = 'Volume',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_euro_css)
            table.cell(t, 1, 9, str.tostring(euro_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_euro_css)
            table.cell(t, 2, 9, str.tostring(sum_euro_volume/num_euro_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_euro_css)


        if is_usa or not only_show_current_session_stats
            table.cell(t, 0,10, text = '𝙐𝙎𝘼 𝙎𝙩𝙖𝙩𝙨 - ' + str.tostring(usa_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_usa_css)
            table.merge_cells(t,0,10,2,10)

            table.cell(t, 0, 11, text = 'H/L Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_usa_css)
            table.cell(t, 1, 11, str.tostring(math.round_to_mintick(usa_h - usa_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)
            table.cell(t, 2, 11, str.tostring(math.round_to_mintick(sum_usa_ranges/num_usa_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)

            table.cell(t, 0, 12, text = 'OR Range',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_usa_css)
            table.cell(t, 1, 12, str.tostring(math.round_to_mintick(usa_orh-usa_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)
            table.cell(t, 2, 12, str.tostring(math.round_to_mintick(sum_usa_or_ranges/num_usa_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)

            table.cell(t, 0, 13, text = 'Volume',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_usa_css)
            table.cell(t, 1, 13, str.tostring(usa_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_usa_css)
            table.cell(t, 2, 13, str.tostring(sum_usa_volume/num_usa_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_usa_css)

    if dashboard_type == 'Mobile' or dashboard_type == 'Mobile Small'
        table.cell(t, 0, 0, text = current_session_text + ' Session',
         text_size = table_size, text_color = table_text, bgcolor = table_color)
        table.merge_cells(t,0,0,2,0)

        table.cell(t, 0, 1, text = " ",
         text_size = table_size, text_color = color.new(table_text,30), bgcolor = table_header_css)
        table.cell(t, 1, 1, text = "Now",
         text_size = table_size, text_color = color.new(table_text,30), bgcolor = table_header_css)
        // table.merge_cells(t,0,1,1,1)

        table.cell(t, 2, 1, text = "Avg",
         text_size = table_size, text_color = color.new(table_text,30), bgcolor = table_header_css)
        table.merge_cells(t,2,1,2,1)

        if is_asia or not only_show_current_session_stats
            table.cell(t, 0, 2, text = '𝘼𝙨𝙞𝙖 - ' + str.tostring(asia_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_asia_css)
            table.merge_cells(t,0,2,2,2)

            table.cell(t, 0, 3, text = 'H/L ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_asia_css)
            table.cell(t, 1, 3, str.tostring(math.round_to_mintick(asia_h - asia_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 3, str.tostring(math.round_to_mintick(sum_asia_ranges/num_asia_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)

            table.cell(t, 0, 4, text = 'OR ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_asia_css)
            table.cell(t, 1, 4, str.tostring(math.round_to_mintick(asia_orh-asia_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 4, str.tostring(math.round_to_mintick(sum_asia_or_ranges/num_asia_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)

            table.cell(t, 0, 5, text = 'Vol ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_asia_css)
            table.cell(t, 1, 5, str.tostring(asia_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)
            table.cell(t, 2, 5, str.tostring(sum_asia_volume/num_asia_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_asia_css)



        if is_euro or not only_show_current_session_stats
            table.cell(t, 0, 6, text = '𝙀𝙪𝙧𝙤 - ' + str.tostring(euro_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_euro_css)
            table.merge_cells(t,0,6,2,6)

            table.cell(t, 0, 7, text = 'H/L ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_euro_css)
            table.cell(t, 1, 7, str.tostring(math.round_to_mintick(euro_h - euro_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)
            table.cell(t, 2, 7, str.tostring(math.round_to_mintick(sum_euro_ranges/num_euro_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)

            table.cell(t, 0, 8, text = 'OR ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_euro_css)
            table.cell(t, 1, 8, str.tostring(math.round_to_mintick(euro_orh-euro_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)
            table.cell(t, 2, 8, str.tostring(math.round_to_mintick(sum_euro_or_ranges/num_euro_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_euro_css)

            table.cell(t, 0, 9, text = 'Vol',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_euro_css)
            table.cell(t, 1, 9, str.tostring(euro_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_euro_css)
            table.cell(t, 2, 9, str.tostring(sum_euro_volume/num_euro_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_euro_css)


        if is_usa or not only_show_current_session_stats
            table.cell(t, 0,10, text = '𝙐𝙎𝘼 - ' + str.tostring(usa_sess_type_text),
             text_size = table_size, text_color = table_text, bgcolor = table_usa_css)
            table.merge_cells(t,0,10,2,10)

            table.cell(t, 0, 11, text = 'H/L ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left,  bgcolor = table_usa_css)
            table.cell(t, 1, 11, str.tostring(math.round_to_mintick(usa_h - usa_l)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)
            table.cell(t, 2, 11, str.tostring(math.round_to_mintick(sum_usa_ranges/num_usa_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)

            table.cell(t, 0, 12, text = 'OR ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_usa_css)
            table.cell(t, 1, 12, str.tostring(math.round_to_mintick(usa_orh-usa_orl)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)
            table.cell(t, 2, 12, str.tostring(math.round_to_mintick(sum_usa_or_ranges/num_usa_sess)),
             text_size = table_size, text_color = table_text, text_halign = text.align_center,  bgcolor = table_usa_css)

            table.cell(t, 0, 13, text = 'Vol ',
             text_size = table_size, text_color = table_text, text_halign = text.align_left, bgcolor = table_usa_css)
            table.cell(t, 1, 13, str.tostring(usa_vol, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_usa_css)
            table.cell(t, 2, 13, str.tostring(sum_usa_volume/num_usa_sess, format.volume),
             text_size = table_size, text_color = table_text, text_halign = text.align_center, bgcolor = table_usa_css)




