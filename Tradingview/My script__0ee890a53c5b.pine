//@version=5
indicator("My script", overlay = false)

f_obv(length) =>
    value = 0.00
    for i = 1 to length
        value += math.sign(close[i] - close[i+1]) * volume
    value

obv_time = 20
obv = f_obv(obv_time)

plot(obv)
