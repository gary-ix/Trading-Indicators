//@version=5
strategy("Trend Toolbox v1", overlay=true, margin_long=100, margin_short=100)

// @keywords: trend-toolbox, sma-cross-strategy, fourteen-twenty-eight-sma, long-entry-crossover, short-entry-crossunder, simple-ma-strategy, backtest-minimal, crossover-long, crossunder-short, dual-sma, no-exits, basic-trend-follow, overlay-strategy, margin-settings, entry-only, toolbox-v1, ma-trend-tool, primitive-cross, swing-proxy, version-one


longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)


