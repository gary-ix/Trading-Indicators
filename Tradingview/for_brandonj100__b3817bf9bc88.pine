barrierBroken := high >= barrier_top or low <= barrier_bot
if barrierBroken

    // stop current lines
    [barr_top, barr_bot] = f_draw_fibs(true, track_StartBN, track_EndBN, track_fibHigh, track_fibLow, track_fibHighBN, track_fibLowBN)

    // check if new lines are not broken - if they are delete other draw
