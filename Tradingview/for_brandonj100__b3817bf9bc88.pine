barrier_pos_lbl = input.string("+1.65", "", inline = "Positive Barrier")
barrier_pos = input(1.65, "", inline = "Positive Barrier")
barrier_pos_css = input(#b51d1d, "", inline = "Positive Barrier")

barrier_neg_lbl = input.string("-0.65", "", inline = "Negative Barrier")
barrier_neg = input(-0.65, "", inline = "Negative Barrier")
barrier_neg_css = input(#b51d1d, "", inline = "Negative Barrier")




// functions
f_array_shift_push(array, new_value_to_add) =>
    array.shift(array)
    array.push(array, new_value_to_add)


// f_array_add_pop(array, new_value_to_add) =>
//     array.unshift(array, new_value_to_add)
//     array.pop(array)


f_stopLine(boxObj) =>
    // box.set_left(boxObj, bar_index[1])  
    // box.set_extend(boxObj, extend.none)  
    box.delete(boxObj)

f_create_fib_values(startBN, endBN, fibTop, fibBot, fibTopBN, fibBotBN) =>
    var float fib0_value = 0.00
    var float fib100_value = 0.00

    var float fib1_value = 0.00
    var float fib2_value = 0.00
    var float fib3_value = 0.00
    var float fib4_value = 0.00
    var float fib5_value = 0.00

    var float fibpos_value = 0.00
    var float fibneg_value = 0.00 

    topIsO = fibTopBN > fibBotBN

    fib0_value := topIsO ? fibTop : fibBot
    fib100_value := topIsO ? fibBot : fibTop
    fib_distance = math.abs(fib0_value - fib100_value)

    fibpos_value := topIsO ?  fib0_value - (fib_distance * barrier_pos) : fib0_value + (fib_distance * barrier_pos)
    fibneg_value := topIsO ?  fib0_value - (fib_distance * barrier_neg) : fib0_value + (fib_distance * barrier_neg)

    [fib0_value, fib100_value, fibpos_value, fibneg_value]


f_draw_fibs(
     stopLines, startBN, endBN, fibTop, fibBot, fibTopBN, fibBotBN
     ) =>


    var float barrier_top = na
    var float barrier_bot = na

    var box fib0Line    = na
    var box fib100Line  = na
    var box fibPOSLine  = na
    var box fibNEGLine  = na

    if stopLines
        f_stopLine(fib0Line)
        f_stopLine(fib100Line)
        f_stopLine(fibPOSLine)
        f_stopLine(fibNEGLine)

        barrier_top := na
        barrier_bot := na

    else


        [fib0_value, fib100_value, fibpos_value, fibneg_value] = f_create_fib_values(startBN, endBN, fibTop, fibBot, fibTopBN, fibBotBN)

        if show_0
            fib0Line := box.new(left=startBN, top=fib0_value, right= endBN, bottom=fib0_value,
                 border_color = color_0, extend = extend.none, text = label_0, text_color = chart.fg_color,
                 text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)

        if show_100
            fib100Line := box.new(left=startBN, top=fib100_value, right= endBN, bottom=fib100_value,
                 border_color = color_100, extend = extend.none, text = label_100, text_color = chart.fg_color,
                 text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)


        fibPOSLine := box.new(left=startBN, top=fibpos_value, right= endBN, bottom=fibpos_value,
                 border_color = barrier_pos_css, extend = extend.none, text = barrier_pos_lbl, text_color = chart.fg_color,
                 text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)

        fibNEGLine := box.new(left=startBN, top=fibneg_value, right= endBN, bottom=fibneg_value,
                 border_color = barrier_neg_css, extend = extend.none, text = barrier_neg_lbl, text_color = chart.fg_color,
                 text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)

        barrier_top := math.max(fibpos_value, fibneg_value)
        barrier_bot := math.min(fibpos_value, fibneg_value)


    // return all line values here for alerts
    [barrier_top, barrier_bot] 
    









// define vars
var startBNs    = array.new_int(100, na)
var endBNs      = array.new_int(100, na)
var fibHighs    = array.new_float(100, na)
var fibLows     = array.new_float(100, na)
var fibHighsBN  = array.new_int(100, na)
var fibLowsBN   = array.new_int(100, na)






var int track_StartBN   = 0
var int track_EndBN     = 0
var float track_fibHigh = na
var float track_fibLow  = na
var int track_fibHighBN = 0
var int track_fibLowBN  = 0

var int candleCount = 0
var int candleSide  = 0

var bool firstDraw      = true
var bool barrierBroken  = false

var float barrier_top   = na
var float barrier_bot   = na


// track candle type / consecutive 
candleSide  := bar_index < cons_candles*2 ? 0 : close >= close[1] ? 1 : -1
candleCount := bar_index < cons_candles*2 ? 0 
     : bar_index  == 0 or candleSide != candleSide[1] ? 1 
     : candleCount[1] + 1






// main
if bar_index < cons_candles * 2
    firstDraw := true


else if firstDraw
    if candleCount[1] == cons_candles
        // cond met
        track_StartBN       := track_StartBN[1]
        track_EndBN         := bar_index + 1
        track_fibHigh       := math.max(high, track_fibHigh[1])
        track_fibLow        := math.min(low, track_fibLow[1])
        track_fibHighBN     := high == track_fibHigh ? bar_index : track_fibHighBN[1]
        track_fibLowBN      := low == track_fibLow ? bar_index : track_fibLowBN[1] 
    else if candleSide != candleSide[1]
        //  reset
        track_StartBN       := bar_index[1]
        track_EndBN         := bar_index + 1
        track_fibHigh       := math.max(high, high[1])
        track_fibLow        := math.min(low, low[1])
        track_fibHighBN     := high[1] == track_fibHigh ? bar_index[1] : high == track_fibHigh ? bar_index : track_fibHighBN[1]
        track_fibLowBN      := low[1] == track_fibLow ? bar_index[1] : low == track_fibLow ? bar_index : track_fibLowBN[1]
    else 
        // track
        track_StartBN       := track_StartBN[1]
        track_EndBN         := bar_index + 1
        track_fibHigh       := math.max(high, track_fibHigh[1])
        track_fibLow        := math.min(low, track_fibLow[1])
        track_fibHighBN     := high == track_fibHigh ? bar_index : track_fibHighBN[1]
        track_fibLowBN      := low == track_fibLow ? bar_index : track_fibLowBN[1]

    if candleCount[1] == cons_candles
        [barr_top, barr_bot] = f_draw_fibs(false, track_StartBN, track_EndBN, track_fibHigh, track_fibLow, track_fibHighBN, track_fibLowBN)
        barrier_top := barr_top
        barrier_bot := barr_bot

        // reset
        track_StartBN       := bar_index[1]
        track_EndBN         := bar_index + 1
        track_fibHigh       := math.max(high, high[1])
        track_fibLow        := math.min(low, low[1])
        track_fibHighBN     := high[1] == track_fibHigh ? bar_index[1] : high == track_fibHigh ? bar_index : track_fibHighBN[1]
        track_fibLowBN      := low[1] == track_fibLow ? bar_index[1] : low == track_fibLow ? bar_index : track_fibLowBN[1]
        
        firstDraw := false


// else
//     if candleCount[1] == cons_candles
