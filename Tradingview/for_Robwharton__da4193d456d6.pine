//  : longsOkay and shortsOkay ? color.new(color.yellow, 90) : longsOkay ? color.new(color.green, 90) : shortsOkay ? color.new(color.red, 90) : na)

// barcolor(longEntry ? color.lime : shortEntry ? color.red : na)

