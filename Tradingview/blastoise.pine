// © goodgains
//@version=4
study("Blastoise's Indicator", shorttitle = "Blastoise's Indicator", overlay = true, max_bars_back = 4000)

// @keywords: pivot-high, pivot-low, swing-high, swing-low, trend-line, support-line, resistance-line, ascending-support, descending-resistance, dynamic-trend-lines, pivot-trend-lines, ema, ema-9, ema-15, ema-21, moving-average, multi-ema, extend-right, price-levels, trend-projection

//Settings
ul = input(true, title = "Upper Lines")
us = input(true, title = "Lower Lines")
ue = input(true, title = "Extend Right")
uw = input(1, defval = 1, minval = 1, maxval = 5, title = "Width Lines")

lcolor = us ? color.red : na
ucolor = ul ? color.lime : na
uextend = ue ? extend.right : extend.none

prd = 20
PPnum = 3

float ph = na, float pl = na
ph := pivothigh(prd, prd)
pl := pivotlow(prd, prd)

getloc(bar_i)=>
    _ret = bar_index + prd - bar_i 
    
t1pos = valuewhen(ph, bar_index, 0)
t1val = nz(high[getloc(t1pos)])
t2pos = valuewhen(ph, bar_index, 1)
t2val = nz(high[getloc(t2pos)])
t3pos = valuewhen(ph, bar_index, 2)
t3val = nz(high[getloc(t3pos)])

b1pos = valuewhen(pl, bar_index, 0)
b1val = nz(low[getloc(b1pos)])
b2pos = valuewhen(pl, bar_index, 1)
b2val = nz(low[getloc(b2pos)])
b3pos = valuewhen(pl, bar_index, 2)
b3val = nz(low[getloc(b3pos)])

getloval(l1, l2)=>
    _ret1 = l1 == 1 ? b1val : l1 == 2 ? b2val : l1 ==3 ? b3val : 0
    _ret2 = l2 == 1 ? b1val : l2 == 2 ? b2val : l2 ==3 ? b3val : 0
    [_ret1, _ret2]

getlopos(l1, l2)=>
    _ret1 = l1 == 1 ? b1pos : l1 == 2 ? b2pos : l1 ==3 ? b3pos : 0
    _ret2 = l2 == 1 ? b1pos : l2 == 2 ? b2pos : l2 ==3 ? b3pos : 0
    [_ret1, _ret2]

gethival(l1, l2)=>
    _ret1 = l1 == 1 ? t1val : l1 == 2 ? t2val : l1 ==3 ? t3val : 0
    _ret2 = l2 == 1 ? t1val : l2 == 2 ? t2val : l2 ==3 ? t3val :  0
    [_ret1, _ret2]

gethipos(l1, l2)=>
    _ret1 = l1 == 1 ? t1pos : l1 == 2 ? t2pos : l1 ==3 ? t3pos : 0
    _ret2 = l2 == 1 ? t1pos : l2 == 2 ? t2pos : l2 ==3 ? t3pos :  0
    [_ret1, _ret2]

var line l1 = na, var line l2 = na, var line l3 = na
var line t1 = na, var line t2 = na, var line t3 = na

line.delete(l1), line.delete(l2), line.delete(l3)
line.delete(t1), line.delete(t2), line.delete(t3)

maxline = 3
ulcolor = color.red
dlcolor = color.blue
countlinelo = 0
countlinehi = 0

if ul or us
    for p1 = 1 to PPnum - 1 
        uv1 = 0.0
        uv2 = 0.0
        up1 = 0
        up2 = 0
        if countlinelo <= maxline
            for p2 = PPnum to p1 + 1
                [val1, val2] = getloval(p1, p2)
                [pos1, pos2] = getlopos(p1, p2)
                if val1 > val2
                    diff = (val1 - val2) / (pos1 - pos2)
                    hline = val2 + diff
                    lloc = bar_index
                    lval = low
                    valid = true
                    xc = 0
                    for x = pos2 + 1 - prd to bar_index
                        xc := x
                        if nz(close[getloc(x + prd)]) < hline
                            valid := false
                            break
                        lloc := x
                        lval := hline
                        hline := hline + diff
                    
                        
                    if valid
                        uv1 := hline
                        uv2 := val2
                        up1 := lloc
                        up2 := pos2
                        break

        dv1 = 0.0
        dv2 = 0.0
        dp1 = 0
        dp2 = 0                
        if countlinehi <= maxline
            for p2 = PPnum to p1 + 1                
                [val1, val2] = gethival(p1, p2)
                [pos1, pos2] = gethipos(p1, p2)
                if val1 < val2
                    diff = (val2 - val1) / (pos1 - pos2)
                    hline = val2 - diff
                    lloc = bar_index
                    lval = high
                    valid = true
                    xc = 0
                    for x = pos2 + 1 - prd to bar_index
                        xc := x
                        if nz(close[getloc(x + prd)]) > hline
                            valid := false
                            break
                        lloc := x
                        lval := hline
                        hline := hline - diff
                        
                    if valid
                        dv1 := hline
                        dv2 := val2
                        dp1 := lloc
                        dp2 := pos2
                        break
                        

        if up1 != 0 and up2 != 0 and countlinelo < maxline
            countlinelo := countlinelo + 1
            l1 := countlinelo == 1 ? line.new(up2 - prd, uv2, up1, uv1, xloc = xloc.bar_index, extend = uextend, color = lcolor, width = uw) : l1
            l2 := countlinelo == 2 ? line.new(up2 - prd, uv2, up1, uv1, xloc = xloc.bar_index, extend = uextend, color = lcolor, width = uw) : l2
            l3 := countlinelo == 3 ? line.new(up2 - prd, uv2, up1, uv1, xloc = xloc.bar_index, extend = uextend, color = lcolor, width = uw) : l3
        

        if dp1 != 0 and dp2 != 0 and countlinehi < maxline
            countlinehi := countlinehi + 1
            t1 := countlinehi == 1 ? line.new(dp2 - prd, dv2, dp1, dv1, xloc = xloc.bar_index, extend = uextend, color = ucolor, width = uw) : t1
            t2 := countlinehi == 2 ? line.new(dp2 - prd, dv2, dp1, dv1, xloc = xloc.bar_index, extend = uextend, color = ucolor, width = uw) : t2
            t3 := countlinehi == 3 ? line.new(dp2 - prd, dv2, dp1, dv1, xloc = xloc.bar_index, extend = uextend, color = ucolor, width = uw) : t3

shortest = ema(close, 9)
short = ema(close, 15)
longer = ema(close, 21)

plot(shortest, color = color.white)
plot(short, color = color.blue)
plot(longer, color = color.aqua)




