//@version=5
indicator("my QQE", overlay = false)

// @keywords: my-qqe, dual-qqe-rsi, quantitative-qualitative-estimation, fast-atr-rsi-line, qqe-bollinger-bands, dual-rsi-smoothed, momentum-histogram, rsi-threshold-bands, wilders-atr-rsi, trend-band-cross, panel-oscillator, rsi-qqe-factor, column-momentum-plot, upper-lower-bb, dual-rsi-instance, smoothed-rsi-ema, rsi-deviation-bands, qqe-trend-state, momentum-bars, threshold-cross-signals

// qqe rsi 1
rsi_period_1      = input.int(6, title='RSI Length', group = 'RSI 1 Settings')
rsi_sf_1          = input(5, title='RSI Smoothing', group = 'RSI 1 Settings')
rsi_qqe_1         = input(3, title='Fast rsi_qqe Factor', group = 'RSI 1 Settings')
rsi_threshold_1   = input(3, title="Thresh-hold", group = 'RSI 1 Settings')
rsi_src_1         = input(close, title="RSI Source", group = 'RSI 1 Settings')
wilders_period_1  = rsi_period_1 * 2 - 1

rsi_value_1           = ta.rsi(rsi_src_1, rsi_period_1)
rsi_ma_1              = ta.ema(rsi_value_1, rsi_sf_1)
rsi_atr_1             = math.abs(rsi_ma_1[1] - rsi_ma_1)
rsi_ma_atr_1          = ta.ema(rsi_atr_1, wilders_period_1)
delta_fast_atrrsi_1   = ta.ema(rsi_ma_atr_1, wilders_period_1) * rsi_qqe_1

var float longband_1 = 0.0
var float shortband_1 = 0.0
var int trend_1 = 0
newshortband_1    = rsi_ma_1 + delta_fast_atrrsi_1
newlongband_1     = rsi_ma_1 - delta_fast_atrrsi_1
longband_1        := rsi_ma_1[1] > longband_1[1] and rsi_ma_1 > longband_1[1] ? math.max(longband_1[1], newlongband_1) : newlongband_1
shortband_1       := rsi_ma_1[1] < shortband_1[1] and rsi_ma_1 < shortband_1[1] ? math.min(shortband_1[1], newshortband_1) : newshortband_1
cross_1           = ta.cross(longband_1[1], rsi_ma_1)
trend_1           := ta.cross(rsi_ma_1, shortband_1[1]) ? 1 : cross_1 ? -1 : nz(trend_1[1], 1)
fast_atr_rsi_tl_1 = trend_1 == 1 ? longband_1 : shortband_1


// qqe bollinger band 1
length_1 = input.int(50, minval=1, title="Bollinger Length", group = 'BB Settings')
mult_1 = input.float(0.35, minval=0.001, maxval=5, step=0.1, title="BB Multiplier", group = 'BB Settings')
basis_1 = ta.sma(fast_atr_rsi_tl_1 - 50, length_1)
dev_1 = mult_1 * ta.stdev(fast_atr_rsi_tl_1 - 50, length_1)
upper_1 = basis_1 + dev_1
lower_1 = basis_1 - dev_1
color_bar_1 = rsi_ma_1 - 50 > upper_1 ? #00c3ff : rsi_ma_1 - 50 < lower_1 ? #ff0062 : color.gray



 

// qqe rsi 2
rsi_period_2      = input.int(6, title='RSI Length', group = 'RSI 2 Settings')
rsi_sf_2          = input(5, title='RSI Smoothing', group = 'RSI 2 Settings')
rsi_qqe_2         = input(3, title='Fast rsi_qqe Factor', group = 'RSI 2 Settings')
rsi_threshold_2   = input(3, title="Thresh-hold", group = 'RSI 2 Settings')
rsi_src_2         = input(close, title="RSI Source", group = 'RSI 2 Settings')
wilders_period_2  = rsi_period_2 * 2 - 1

rsi_value_2           = ta.rsi(rsi_src_2, rsi_period_2)
rsi_ma_2              = ta.ema(rsi_value_2, rsi_sf_2)
rsi_atr_2             = math.abs(rsi_ma_2[1] - rsi_ma_2)
rsi_ma_atr_2          = ta.ema(rsi_atr_2, wilders_period_2)
delta_fast_atrrsi_2   = ta.ema(rsi_ma_atr_2, wilders_period_2) * rsi_qqe_2

var float longband_2 = 0.0
var float shortband_2 = 0.0
var int trend_2 = 0
newshortband_2    = rsi_ma_2 + delta_fast_atrrsi_2
newlongband_2     = rsi_ma_2 - delta_fast_atrrsi_2
longband_2        := rsi_ma_2[1] > longband_2[1] and rsi_ma_2 > longband_2[1] ? math.max(longband_2[1], newlongband_2) : newlongband_2
shortband_2       := rsi_ma_2[1] < shortband_2[1] and rsi_ma_2 < shortband_2[1] ? math.min(shortband_2[1], newshortband_2) : newshortband_2
cross_2           = ta.cross(longband_2[1], rsi_ma_2)
trend_2           := ta.cross(rsi_ma_2, shortband_2[1]) ? 1 : cross_2 ? -1 : nz(trend_2[1], 1)
fast_atr_rsi_tl_2 = trend_2 == 1 ? longband_2 : shortband_2



hcolor2 = rsi_ma_2 - 50 > rsi_threshold_2 ? color.silver :
   rsi_ma_2 - 50 < 0 - rsi_threshold_2 ? color.silver : na

Greenbar1 = rsi_ma_2 - 50 > rsi_threshold_2
Greenbar2 = rsi_ma_1 - 50 > upper_1

Redbar1 = rsi_ma_2 - 50 < 0 - rsi_threshold_2
Redbar2 = rsi_ma_1 - 50 < lower_1
// plot(Greenbar1 and Greenbar2 == 1 ? rsi_ma_2 - 50 : na, title="rsi_qqe Up", style=plot.style_columns, color=#00c3ff)
// plot(Redbar1 and Redbar2 == 1 ? rsi_ma_2 - 50 : na, title="rsi_qqe Down", style=plot.style_columns, color=#ff0062)


plot_value = (rsi_ma_1-50)*1
plot_color = plot_value >= 50 ? color.lime : plot_value > 0 ? color.rgb(54, 156, 148)
 : plot_value <= -50 ? color.red : color.rgb(212, 98, 146)
plot(plot_value, color=plot_color, title='Momentum', style=plot.style_columns, linewidth = 3)

