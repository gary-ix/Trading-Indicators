        table.merge_cells(table_id=t, start_column=1, start_row=6, end_column=4, end_row=6)


        //ATR Row
        table.cell(t, 0, 7, text='ATR', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 7, text=str.tostring(atr, format.mintick), width=0, bgcolor=atr_color,
         text_color=dashboard_text, text_size=table_size, text_halign=text.align_center)
        table.cell(t, 2, 7, text=' ', width=0, bgcolor=atr_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 3, 7, text=' ', width=0, bgcolor=atr_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 4, 7, text=' ', width=0, bgcolor=atr_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.merge_cells(table_id=t, start_column=1, start_row=7, end_column=4, end_row=7)


        //RSI Row
        table.cell(t, 0, 8, text='RSI', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 8, text=str.tostring(rsi, format.mintick), width=0, bgcolor=rsi_color,
         text_color=dashboard_text, text_size=table_size, text_halign=text.align_center)
        table.cell(t, 2, 8, text=' ', width=0, bgcolor=rsi_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 3, 8, text=' ', width=0, bgcolor=rsi_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 4, 8, text=' ', width=0, bgcolor=rsi_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.merge_cells(table_id=t, start_column=1, start_row=8, end_column=4, end_row=8)


        //ADR vs DR Row
        table.cell(t, 0, 9, text='ADR %', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 9, text=str.tostring(adr_pct, format.percent) + (adr_pct < 100 ?  ' : ' + str.tostring(adr_val-dr_val) : ''),
         width=0, bgcolor=dashboard_color, text_color=dashboard_text, text_size=table_size, text_halign=text.align_center)
        table.cell(t, 2, 9, text=' ', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 3, 9, text=' ', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 4, 9, text=' ', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.merge_cells(table_id=t, start_column=1, start_row=9, end_column=4, end_row=9)


    else
    
        // Title Row
        table.cell(t, 0, 0, text='Xact', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 0, text='', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
