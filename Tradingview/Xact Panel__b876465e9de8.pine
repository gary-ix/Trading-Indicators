        table.merge_cells(table_id=t, start_column=1, start_row=4, end_column=4, end_row=4)

        // RVOL Row
        table.cell(t, 0, 6, text='RVOL', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 6, text=str.tostring(avg_rvol, format.mintick), width=0, bgcolor=rvol_color,
         text_color=dashboard_text, text_size=table_size, text_halign=text.align_center)
        table.cell(t, 2, 6, text=' ', bgcolor=rvol_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 3, 6, text=' ', width=0, bgcolor=rvol_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 4, 6, text=' ', width=0, bgcolor=rvol_color, text_color=dashboard_text,
