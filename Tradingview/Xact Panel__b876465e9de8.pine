         text_color=dashboard_text, text_size=table_size, text_halign=text.align_center)
        // table.merge_cells(t,1,2,4,2)

        // MACD Row
        table.cell(t, 0, 4, text='MACD', width=0, bgcolor=dashboard_color, text_color=dashboard_text,
         text_size=table_size, text_halign=text.align_center)
        table.cell(t, 1, 4, text=' ', width=0, bgcolor=zerolag_color, text_color=dashboard_text,
