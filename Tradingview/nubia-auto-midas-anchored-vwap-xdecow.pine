//@version=5
indicator('Nubia - Auto Midas Anchored VWAP [xdecow]', shorttitle='Nubia [xdecow]', overlay=true, max_bars_back=2584)

// @keywords: anchored-vwap, midas-curve, auto-pivot-anchor, highest-lowest-avwap, volume-weighted-path, hlc3-source, pivot-length-scan, dynamic-anchor, always-show-toggle, overlay-vwap-lines, swing-high-anchor, swing-low-anchor, cumulative-volume, price-path-average, xdecow-variant, liquidity-anchor, trend-path, avwap-comparison, intraday-anchoring, pivot-driven-vwap

md_show = input(false, 'Always show')

getVwap(src, length, vol) =>
    uvol = vol
    uwgt = vol * src

    if length < 1
        na
    else
        for i = 1 to length - 1 by 1
            uvol += vol[i]
            uwgt += vol[i] * src[i]
            uwgt
        uwgt / uvol

getMidas(len, isHighest) =>
    if na(len)
        [na, na]
    else
        mid = getVwap(hlc3, len, volume)
        value = if isHighest
            getVwap(high, len, volume)
        else
            getVwap(low, len, volume)

        [mid, value]

getMidasTrend(vtop, vbot) =>
    (na(vtop) or close > vtop) and close > vbot ? 1 : (na(vbot) or close < vbot) and close < vtop ? -1 : 0


ma1_len = input.int(17, '#1 Length', minval=2)

ma1_highbars = ta.highestbars(ma1_len) * -1
ma1_lowbars = ta.lowestbars(ma1_len) * -1

[ma1_top_mid, ma1_top_high] = getMidas(ma1_highbars, true)
[ma1_bot_mid, ma1_bot_low] = getMidas(ma1_lowbars, false)

ma1_top_visible = ma1_top_high > low
ma1_bot_visible = ma1_bot_low < high
ma1_top_color = ma1_top_visible ? color.red : md_show ? #926966 : na
ma1_bot_color = ma1_bot_visible ? color.green : md_show ? #527552 : na

ma1_top_p1 = plot(ma1_top_visible or md_show ? ma1_top_high : na, color=ma1_top_color, linewidth=1, style=plot.style_linebr, title='#1 Highest AVWAP')
ma1_top_p2 = plot(ma1_top_visible or md_show ? ma1_top_mid : na, color=na, editable=false)
fill(ma1_top_p1, ma1_top_p2, ma1_top_color, title='#1 Highest background', transp=90)

ma1_bot_p1 = plot(ma1_bot_visible or md_show ? ma1_bot_low : na, color=ma1_bot_color, linewidth=1, style=plot.style_linebr, title='#1 Lowest AVWAP')
ma1_bot_p2 = plot(ma1_bot_visible or md_show ? ma1_bot_mid : na, color=na, editable=false)
fill(ma1_bot_p1, ma1_bot_p2, ma1_bot_color, title='#1 Lowest background', transp=90)

ma1_trend = getMidasTrend(ma1_top_high, ma1_bot_low)




