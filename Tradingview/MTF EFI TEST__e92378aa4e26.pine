var float efi_sums = 0.00
efi_sums := efi_tf1
 + efi_tf2
 + efi_tf3
 + efi_tf4
 + efi_tf5
 + efi_tf6
 + efi_tf7
 + efi_tf8
 + efi_tf9
 + efi_tf10


var float efi_max = 0.00
var float efi_min = 0.00

efi_max := math.max(
 math.abs(nz(efi_tf1*1000,0)),
 math.abs(nz(efi_tf2*1000,0)),
 math.abs(nz(efi_tf3*1000,0)),
 math.abs(nz(efi_tf4*1000,0)),
 math.abs(nz(efi_tf5*1000,0)),
 math.abs(nz(efi_tf6*1000,0)),
 math.abs(nz(efi_tf6*1000,0)),
 math.abs(nz(efi_tf8*1000,0)),
 math.abs(nz(efi_tf9*1000,0)),
 math.abs(nz(efi_tf10*1000,0)))


efi_min := math.min(
 math.abs(efi_tf1),
 math.abs(efi_tf2),
 math.abs(efi_tf3),
 math.abs(efi_tf4),
 math.abs(efi_tf5),
 math.abs(efi_tf6),
 math.abs(efi_tf7),
 math.abs(efi_tf8),
 math.abs(efi_tf9),
 math.abs(efi_tf10))

 
// xrange = xMax - xMin
// y = 100 * efi / xrange
tf1_mult = 100 * efi_tf1 / (high_efi_tf1 - low_efi_tf1)
tf2_mult = 100 * efi_tf2 / (high_efi_tf2 - low_efi_tf2)
tf3_mult = 100 * efi_tf3 / (high_efi_tf3 - low_efi_tf3)
tf4_mult = 100 * efi_tf4 / (high_efi_tf4 - low_efi_tf4)



