 : efi_side3 == -1 ? math.max(0, 4 - math.max(1, math.floor((4 * math.abs(tf3_mult)))))
 : na

column_tf3e := efi_side3 == 1 ? 5 + math.min(1, math.floor((4 * tf3_mult)))
 : efi_side3 == -1 ? 3
 : na




 
