    color_sym1_tf7 := efi_side7 == 1 ? panelbull_color : efi_side7 == -1 ? panelbear_color : dashboard_color
    color_sym1_tf8 := efi_side8 == 1 ? panelbull_color : efi_side8 == -1 ? panelbear_color : dashboard_color
    color_sym1_tf9 := efi_side9 == 1 ? panelbull_color : efi_side9 == -1 ? panelbear_color : dashboard_color
    color_sym1_tf10 := efi_side10 == 1 ? panelbull_color : efi_side10 == -1 ? panelbear_color : dashboard_color

    text_sym1_tf1 := tf1 == "" ? timeframe.period : tf1
    text_sym1_tf2 := tf2 == "" ? timeframe.period : tf2
    text_sym1_tf3 := tf3 == "" ? timeframe.period  : tf3
    text_sym1_tf4 := tf4 == "" ? timeframe.period : tf4
    text_sym1_tf5 := tf5 == "" ? timeframe.period : tf5
    text_sym1_tf6 := tf6 == "" ? timeframe.period : tf6
    text_sym1_tf7 := tf7 == "" ? timeframe.period : tf7
    text_sym1_tf8 := tf8 == "" ? timeframe.period : tf8
    text_sym1_tf9 := tf9 == "" ? timeframe.period : tf9
    text_sym1_tf10 := tf10 == "" ? timeframe.period : tf10

    table.cell(t, 0, 0, text="MTF EFI", width=0, bgcolor=dashboard_color,
     text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
    table.merge_cells(t, start_column=0, start_row=0, end_column=9 , end_row=0)


    if use_tf1

        table.cell(t, 4, 1, text= text_sym1_tf1, width=0, bgcolor=color_sym1_tf1, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        table.cell(t, column_tf1s, 1, text= ' ', width=0, bgcolor=color_sym1_tf1, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        table.merge_cells(t, start_column=column_tf1s, start_row=1, end_column=column_tf1e, end_row=1)

    if use_tf2
        table.cell(t, 4, 2, text= text_sym1_tf2, width=0, bgcolor=color_sym1_tf2, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        table.cell(t, column_tf2s, 2, text= ' ', width=0, bgcolor=color_sym1_tf2, 
