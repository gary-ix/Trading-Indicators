var int column_tf1s = 0
var int column_tf1e = 0
column_tf1s := efi_side1 == 1 ? 5 
 : efi_side1 == -1 ? 4 - math.max(1, math.floor((4 * math.abs(tf1_mult))))
 : na

column_tf1e := efi_side1 == 1 ? 5 + math.min(1, math.floor((4 * tf1_mult)))
 : efi_side1 == -1 ? 3
 : na

var int column_tf2s = 0
var int column_tf2e = 0
column_tf2s := efi_side2 == 1 ? 5 
 : efi_side2 == -1 ? math.max(0, 4 - math.max(1, math.floor((4 * math.abs(tf2_mult)))))
 : na

column_tf2e := efi_side2 == 1 ? 5 + math.min(1, math.floor((4 * tf2_mult)))
 : efi_side2 == -1 ? 3
 : na

var int column_tf3s = 0
var int column_tf3e = 0
