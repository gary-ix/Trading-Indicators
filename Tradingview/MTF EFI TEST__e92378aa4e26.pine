        table.merge_cells(t, start_column=column_tf2s, start_row=2, end_column=column_tf2e, end_row=2)

    if use_tf3
        table.cell(t, 4, 3, text= text_sym1_tf3, width=0, bgcolor=color.teal, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        table.cell(t, 5, 3, text= ' ', width=0, bgcolor=color.teal, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        table.merge_cells(t, start_column=5, start_row=3, end_column=7, end_row=3)

    if use_tf4
        table.cell(t, 4, 4, text= text_sym1_tf4, width=0,  bgcolor=color_sym1_tf4, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
        // table.merge_cells(t, start_column=4, start_row=4, end_column=column_tf3, end_row=4)



    if use_tf5
        table.cell(t, 4, 5, text= text_sym1_tf5, width=0, bgcolor=color_sym1_tf5, 
         text_color=dashboard_text, text_halign = text.align_center, text_size = label_size)
    if use_tf6
        table.cell(t, 4, 6, text= text_sym1_tf6, width=0, bgcolor=color_sym1_tf6, 
